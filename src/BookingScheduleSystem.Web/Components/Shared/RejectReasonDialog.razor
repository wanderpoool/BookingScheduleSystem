<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body1">
                Reject booking for <strong>@ScheduleTitle</strong>?
            </MudText>
            <MudTextField @bind-Value="_reason"
                          Label="Reason (optional)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Placeholder="Let the customer know why..."
                          FullWidth="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm"
                       StartIcon="@Icons.Material.Filled.Close">
                Reject Booking
            </MudButton>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <MudStack Spacing="2" Style="width: 100%;">
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm"
                           StartIcon="@Icons.Material.Filled.Close"
                           FullWidth="true"
                           Size="Size.Medium"
                           Style="min-height: 48px;">
                    Reject Booking
                </MudButton>
                <MudButton OnClick="Cancel"
                           FullWidth="true"
                           Size="Size.Medium"
                           Style="min-height: 48px;">
                    Cancel
                </MudButton>
            </MudStack>
        </MudHidden>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string ScheduleTitle { get; set; } = "this schedule";

    private string? _reason;

    private void Cancel() => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(DialogResult.Ok(_reason ?? string.Empty));
}
