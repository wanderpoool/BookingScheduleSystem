@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject ITenantSlugService SlugService
@inject AuthenticationStateProvider AuthStateProvider

@code {
    private bool _hasChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasChecked)
        {
            _hasChecked = true;

            // After a page refresh, JS interop may not be fully ready on the first
            // OnAfterRenderAsync call, causing GetAuthenticationStateAsync to return
            // anonymous state even though valid tokens exist in localStorage.
            // Retry a few times with a short delay to allow the circuit to stabilize.
            for (var attempt = 0; attempt < 3; attempt++)
            {
                if (attempt > 0)
                    await Task.Delay(250);

                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;

                if (user.Identity?.IsAuthenticated == true)
                {
                    // Auth state recovered — notify so AuthorizeRouteView re-evaluates
                    if (AuthStateProvider is CustomAuthenticationStateProvider custom)
                        custom.NotifyAuthenticationStateChanged();
                    return;
                }
            }

            var returnUrl = Uri.EscapeDataString(Navigation.Uri);
            var loginPath = SlugService.BuildUrl("/login");
            Navigation.NavigateTo($"{loginPath}?returnUrl={returnUrl}", forceLoad: true);
        }
    }
}
