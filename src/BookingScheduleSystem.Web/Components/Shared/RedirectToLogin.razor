@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _hasChecked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only check auth after the interactive circuit is established (not during prerender).
        // OnAfterRenderAsync is never called during prerender, so JS interop is safe here.
        if (firstRender && !_hasChecked)
        {
            _hasChecked = true;

            if (AuthenticationStateTask == null)
                return;

            var authState = await AuthenticationStateTask;
            var user = authState.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                var returnUrl = Uri.EscapeDataString(Navigation.Uri);
                Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: true);
            }
        }
    }
}
