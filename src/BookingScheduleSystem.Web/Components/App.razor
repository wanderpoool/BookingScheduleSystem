<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Design System CSS *@
    <link rel="stylesheet" href="@Assets["design-tokens.css"]" />
    <link rel="stylesheet" href="@Assets["global-styles.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BookingScheduleSystem.Web.styles.css"]" />

    @* Fonts *@
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />

    @* MudBlazor *@
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <div id="components-reconnect-modal" style="display:none;"></div>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 3,
                    retryIntervalMilliseconds: 2000
                }
            }
        });

        // Hide reconnect UI and auto-reload when circuit is lost
        new MutationObserver(() => {
            const modal = document.getElementById('components-reconnect-modal');
            if (modal && (modal.classList.contains('components-reconnect-rejected') ||
                          modal.classList.contains('components-reconnect-failed'))) {
                location.reload();
            }
        }).observe(document.documentElement, { attributes: true, subtree: true, attributeFilter: ['class'] });
    </script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/phone-input.js"></script>
    <script src="js/bookme-calendar.js"></script>
    <script src="js/file-download.js"></script>
</body>

</html>
