@inject NavigationManager Navigation

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Dashboard</MudNavLink>

    <MudNavGroup Title="Bookings" Icon="@Icons.Material.Filled.EventNote" Expanded="true">
        <MudNavLink Href="/bookings" Icon="@Icons.Material.Filled.CalendarMonth">My Bookings</MudNavLink>
        <MudNavLink Href="/bookings/new" Icon="@Icons.Material.Filled.Add">New Booking</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Schedules" Icon="@Icons.Material.Filled.Schedule">
        <MudNavLink Href="/schedules" Icon="@Icons.Material.Filled.List">All Schedules</MudNavLink>
        <MudNavLink Href="/schedules/create" Icon="@Icons.Material.Filled.AddCircle">Create Schedule</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Providers" Icon="@Icons.Material.Filled.People">
        <MudNavLink Href="/providers" Icon="@Icons.Material.Filled.PeopleAlt">View Providers</MudNavLink>
        <MudNavLink Href="/providers/invite" Icon="@Icons.Material.Filled.PersonAdd">Invite Provider</MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-2" />

    <MudNavGroup Title="Organization" Icon="@Icons.Material.Filled.Business">
        <MudNavLink Href="/organization/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        <MudNavLink Href="/organization/operating-hours" Icon="@Icons.Material.Filled.AccessTime">Operating Hours</MudNavLink>
        <MudNavLink Href="/organization/subscription" Icon="@Icons.Material.Filled.CardMembership">Subscription</MudNavLink>
    </MudNavGroup>

    <MudNavLink Href="/analytics" Icon="@Icons.Material.Filled.Analytics">Analytics</MudNavLink>

    <MudDivider Class="my-2" />

    <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">My Profile</MudNavLink>
    <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
</MudNavMenu>

