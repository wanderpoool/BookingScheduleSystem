@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject ITenantSlugService SlugService

<MudNavMenu Class="px-2 pt-2">
    <MudNavLink Href="@SlugService.BuildUrl("/dashboard")" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <MudNavLink Href="@SlugService.BuildUrl("/browse-schedules")" Icon="@Icons.Material.Filled.BookOnline">Book a Schedule</MudNavLink>
    <MudNavLink Href="@SlugService.BuildUrl("/my-bookings")" Icon="@Icons.Material.Filled.EventNote">My Bookings</MudNavLink>

    <AuthorizeView Roles="Provider,GlobalAdmin">
        <Authorized>
            <MudDivider Class="my-3" />

            <MudText Typo="Typo.overline" Class="px-4 mb-1"
                     Style="font-weight: 600; letter-spacing: 0.08em; color: var(--mud-palette-text-secondary);">
                MANAGEMENT
            </MudText>

            <MudNavGroup Title="Schedules" Icon="@Icons.Material.Filled.CalendarMonth" Expanded="false">
                <MudNavLink Href="@SlugService.BuildUrl("/schedules")" Icon="@Icons.Material.Filled.ViewList">Manage Schedules</MudNavLink>
                <MudNavLink Href="@SlugService.BuildUrl("/schedules/create")" Icon="@Icons.Material.Filled.AddCircle">Create Schedule</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="People" Icon="@Icons.Material.Filled.Group" Expanded="false">
                <MudNavLink Href="@SlugService.BuildUrl("/providers")" Icon="@Icons.Material.Filled.Badge">Manage Providers</MudNavLink>
                <MudNavLink Href="@SlugService.BuildUrl("/customers")" Icon="@Icons.Material.Filled.People">Manage Customers</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Organization" Icon="@Icons.Material.Filled.Business" Expanded="false">
                <MudNavLink Href="@SlugService.BuildUrl("/organization")" Icon="@Icons.Material.Filled.Settings">Organization Settings</MudNavLink>
                <MudNavLink Href="@SlugService.BuildUrl("/subscription")" Icon="@Icons.Material.Filled.CreditCard">Subscription</MudNavLink>
            </MudNavGroup>

            <MudDivider Class="my-3" />

            <MudNavLink Href="@SlugService.BuildUrl("/analytics")" Icon="@Icons.Material.Filled.BarChart">Analytics</MudNavLink>
            <MudNavLink Href="@SlugService.BuildUrl("/settings")" Icon="@Icons.Material.Filled.Tune">Settings</MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="GlobalAdmin">
        <Authorized>
            <MudDivider Class="my-3" />

            <MudText Typo="Typo.overline" Class="px-4 mb-1"
                     Style="font-weight: 600; letter-spacing: 0.08em; color: var(--mud-palette-text-secondary);">
                PLATFORM ADMIN
            </MudText>

            <MudNavGroup Title="Administration" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                <MudNavLink Href="@SlugService.BuildUrl("/admin/dashboard")" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                <MudNavLink Href="@SlugService.BuildUrl("/admin/users")" Icon="@Icons.Material.Filled.SupervisedUserCircle">Manage Users</MudNavLink>
                <MudNavLink Href="@SlugService.BuildUrl("/admin/subscriptions")" Icon="@Icons.Material.Filled.CreditCard">Subscriptions</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <MudDivider Class="my-3" />

    <MudNavLink Href="@SlugService.BuildUrl("/profile")" Icon="@Icons.Material.Filled.Person">My Profile</MudNavLink>
</MudNavMenu>

@code {
    // Navigation menu state managed by MudBlazor
}
