@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IAuthenticationService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient HttpClient
@inject ITenantService TenantService

<MudThemeProvider @ref="@_mudThemeProvider" IsDarkMode="@_isDarkMode" Theme="@_customTheme" />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3" Style="flex: 1 1 0; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@_organizationName</MudText>

        <div style="display: flex; align-items: center; flex-shrink: 0;">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="@ToggleDarkMode" />

            <AuthorizeView>
                <Authorized>
                    <NotificationBell />
                </Authorized>
            </AuthorizeView>

            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mr-2 d-none d-sm-flex">@_userName</MudText>
            <MudMenu Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick="@NavigateToProfile">Profile</MudMenuItem>
            <MudMenuItem OnClick="@NavigateToSettings">Settings</MudMenuItem>
            <MudDivider />
            <MudMenuItem OnClick="@Logout">Logout</MudMenuItem>
        </MudMenu>
        </div>
    </MudAppBar>

    <MudDrawer Open="@_drawerOpen" OpenChanged="@((val) => _drawerOpen = val)"
               Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0">
        <MudDrawerHeader Class="py-4 px-5">
            <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.02em;">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 px-4 px-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private bool _isDarkMode = false;
    private MudThemeProvider? _mudThemeProvider;
    private string _userName = string.Empty;
    private string _organizationName = "Booking Schedule System";

    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            // Primary Blue - Trustworthy & Professional
            Primary = "#1D4ED8",
            PrimaryContrastText = "#FFFFFF",
            PrimaryDarken = "#1E3A8A",
            PrimaryLighten = "#3B82F6",

            // Secondary Teal - Energetic & Modern
            Secondary = "#0D9488",
            SecondaryContrastText = "#FFFFFF",
            SecondaryDarken = "#0F766E",
            SecondaryLighten = "#5EEAD4",

            // Tertiary Purple - Special Features
            Tertiary = "#7C3AED",
            TertiaryContrastText = "#FFFFFF",
            TertiaryDarken = "#6D28D9",
            TertiaryLighten = "#A78BFA",

            // Semantic Colors
            Success = "#10B981",
            SuccessContrastText = "#FFFFFF",
            Info = "#3B82F6",
            InfoContrastText = "#FFFFFF",
            Warning = "#F59E0B",
            WarningContrastText = "#FFFFFF",
            Error = "#EF4444",
            ErrorContrastText = "#FFFFFF",

            // Backgrounds
            Background = "#FFFFFF",
            Surface = "#FFFFFF",

            // AppBar
            AppbarBackground = "#FFFFFF",
            AppbarText = "#111827",

            // Drawer
            DrawerBackground = "#FFFFFF",
            DrawerText = "#111827",
            DrawerIcon = "#6B7280",

            // Text
            TextPrimary = "#111827",
            TextSecondary = "#6B7280",
            TextDisabled = "#9CA3AF",

            // Borders & Dividers
            Divider = "#EAECF0",
            DividerLight = "#F2F4F7",
            LinesDefault = "#EAECF0",
            LinesInputs = "#D1D5DB",

            // Actions
            ActionDefault = "#6B7280",
            ActionDisabled = "#9CA3AF",
            ActionDisabledBackground = "#F3F4F6",

            // Hover/Ripple states
            HoverOpacity = 0.04,
            RippleOpacity = 0.08
        },
        PaletteDark = new PaletteDark()
        {
            // Primary Blue - Lighter for dark backgrounds
            Primary = "#60A5FA",
            PrimaryContrastText = "#0F1419",
            PrimaryDarken = "#3B82F6",
            PrimaryLighten = "#93C5FD",

            // Secondary Teal - Lighter
            Secondary = "#5EEAD4",
            SecondaryContrastText = "#0F1419",
            SecondaryDarken = "#2DD4BF",
            SecondaryLighten = "#99F6E4",

            // Tertiary Purple
            Tertiary = "#A78BFA",
            TertiaryContrastText = "#0F1419",
            TertiaryDarken = "#8B5CF6",
            TertiaryLighten = "#C4B5FD",

            // Semantic Colors - Adjusted for dark mode
            Success = "#34D399",
            SuccessContrastText = "#0F1419",
            Info = "#60A5FA",
            InfoContrastText = "#0F1419",
            Warning = "#FBBF24",
            WarningContrastText = "#0F1419",
            Error = "#F87171",
            ErrorContrastText = "#0F1419",

            // Backgrounds
            Background = "#111318",
            Surface = "#1C1F2A",

            // AppBar
            AppbarBackground = "#1C1F2A",
            AppbarText = "#F9FAFB",

            // Drawer
            DrawerBackground = "#1C1F2A",
            DrawerText = "#F9FAFB",
            DrawerIcon = "#9CA3AF",

            // Text
            TextPrimary = "#F9FAFB",
            TextSecondary = "#9CA3AF",
            TextDisabled = "#6B7280",

            // Borders & Dividers
            Divider = "#374151",
            DividerLight = "#252A3A",
            LinesDefault = "#374151",
            LinesInputs = "#4B5563",

            // Actions
            ActionDefault = "#9CA3AF",
            ActionDisabled = "#6B7280",
            ActionDisabledBackground = "#252A3A",

            // Hover/Ripple states
            HoverOpacity = 0.12,
            RippleOpacity = 0.2
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "14px",

            // Drawer
            DrawerWidthLeft = "280px",
            DrawerWidthRight = "360px",
            DrawerMiniWidthLeft = "64px",

            // AppBar
            AppbarHeight = "56px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? user.FindFirst(ClaimTypes.Name)?.Value ?? "";

            // Restore auth headers on page refresh
            try
            {
                var token = await AuthService.GetTokenAsync();
                if (!string.IsNullOrEmpty(token))
                {
                    HttpClient.DefaultRequestHeaders.Authorization =
                        new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                }

                var tenantIdClaim = user.FindFirst("TenantId")?.Value;
                if (!string.IsNullOrEmpty(tenantIdClaim))
                {
                    HttpClient.DefaultRequestHeaders.Remove("X-Tenant-Id");
                    HttpClient.DefaultRequestHeaders.Add("X-Tenant-Id", tenantIdClaim);

                    var tenant = await TenantService.GetTenantAsync(Guid.Parse(tenantIdClaim));
                    if (tenant != null)
                    {
                        _organizationName = tenant.Name;
                    }
                }
            }
            catch
            {
                // localStorage may not be available during prerender
            }
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/profile");
    }

    private void NavigateToSettings()
    {
        Navigation.NavigateTo("/settings");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
