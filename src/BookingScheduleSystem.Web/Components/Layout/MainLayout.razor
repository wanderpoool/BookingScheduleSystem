@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IAuthenticationService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient HttpClient
@inject ITenantService TenantService
@inject ITenantSlugService SlugService
@inject IJSRuntime JS

<MudThemeProvider @ref="@_mudThemeProvider" IsDarkMode="false" Theme="@_customTheme" />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3" Style="flex: 1 1 0; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@_organizationName</MudText>

        <div style="display: flex; align-items: center; flex-shrink: 0;">
            <AuthorizeView>
                <Authorized>
                    <NotificationBell />
                </Authorized>
            </AuthorizeView>

            <MudText Typo="Typo.body2" Color="Color.Inherit" Class="mr-2 d-none d-sm-flex">@_userName</MudText>
            <MudMenu Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick="@NavigateToProfile">Profile</MudMenuItem>
            <MudMenuItem OnClick="@NavigateToSettings">Settings</MudMenuItem>
            <MudDivider />
            <MudMenuItem OnClick="@Logout">Logout</MudMenuItem>
        </MudMenu>
        </div>
    </MudAppBar>

    <MudDrawer Open="@_drawerOpen" OpenChanged="@((val) => _drawerOpen = val)"
               Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0">
        <MudDrawerHeader Class="py-4 px-5">
            <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.02em;">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 px-4 px-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@implements IDisposable

@code {
    private bool _drawerOpen = false;
    private MudThemeProvider? _mudThemeProvider;
    private string _userName = string.Empty;
    private string _organizationName = "Booking Schedule System";
    private bool _contextLoaded = false;

    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            // Primary Orange - Warm & Inviting
            Primary = "#E85D2A",
            PrimaryContrastText = "#FFFFFF",
            PrimaryDarken = "#C94A1D",
            PrimaryLighten = "#F28B5F",

            // Secondary Navy - Professional & Grounded
            Secondary = "#1B2D45",
            SecondaryContrastText = "#FFFFFF",
            SecondaryDarken = "#0F1D30",
            SecondaryLighten = "#3D5A80",

            // Tertiary Gold - Accent & Highlights
            Tertiary = "#FFC53D",
            TertiaryContrastText = "#1B2D45",
            TertiaryDarken = "#D9A020",
            TertiaryLighten = "#FFD97A",

            // Semantic Colors
            Success = "#10B981",
            SuccessContrastText = "#FFFFFF",
            Info = "#3B82F6",
            InfoContrastText = "#FFFFFF",
            Warning = "#F59E0B",
            WarningContrastText = "#FFFFFF",
            Error = "#EF4444",
            ErrorContrastText = "#FFFFFF",

            // Backgrounds
            Background = "#FFF8F0",
            Surface = "#FFFFFF",

            // AppBar
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1B2D45",

            // Drawer
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1B2D45",
            DrawerIcon = "#5A6B80",

            // Text
            TextPrimary = "#1B2D45",
            TextSecondary = "#5A6B80",
            TextDisabled = "#9CA3AF",

            // Borders & Dividers
            Divider = "#E8DFD5",
            DividerLight = "#F5EDE4",
            LinesDefault = "#E8DFD5",
            LinesInputs = "#D5CBC0",

            // Actions
            ActionDefault = "#5A6B80",
            ActionDisabled = "#9CA3AF",
            ActionDisabledBackground = "#FFF5EC",

            // Hover/Ripple states
            HoverOpacity = 0.04,
            RippleOpacity = 0.08
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "14px",

            // Drawer
            DrawerWidthLeft = "280px",
            DrawerWidthRight = "360px",
            DrawerMiniWidthLeft = "64px",

            // AppBar
            AppbarHeight = "56px"
        }
    };

    protected override void OnInitialized()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        Navigation.LocationChanged += OnLocationChanged;

        // Set initial slug from current URL
        ExtractAndSetSlugFromPath(new Uri(Navigation.Uri).AbsolutePath);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserContextAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_contextLoaded)
        {
            await LoadUserContextAsync();
            if (_contextLoaded)
            {
                // Notify auth state changed so AuthorizeRouteView re-evaluates
                // (the initial render may have returned anonymous due to JS interop not being ready)
                if (AuthStateProvider is CustomAuthenticationStateProvider customProvider)
                {
                    customProvider.NotifyAuthenticationStateChanged();
                }

                // Dismiss branded loading screen if still visible
                try { await JS.InvokeVoidAsync("brandedLoading.dismiss"); } catch { }

                StateHasChanged();
            }
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        _contextLoaded = false;
        await LoadUserContextAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUserContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? user.FindFirst(ClaimTypes.Name)?.Value ?? "";

            // Restore auth headers on page refresh
            try
            {
                var token = await AuthService.GetTokenAsync();
                if (!string.IsNullOrEmpty(token))
                {
                    HttpClient.DefaultRequestHeaders.Authorization =
                        new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
                }

                var tenantIdClaim = user.FindFirst("TenantId")?.Value;
                if (!string.IsNullOrEmpty(tenantIdClaim))
                {
                    HttpClient.DefaultRequestHeaders.Remove("X-Tenant-Id");
                    HttpClient.DefaultRequestHeaders.Add("X-Tenant-Id", tenantIdClaim);

                    var tenant = await TenantService.GetTenantAsync(Guid.Parse(tenantIdClaim));
                    if (tenant != null)
                    {
                        _organizationName = tenant.Name;
                        SlugService.SetSlug(tenant.Subdomain);
                    }
                }

                _contextLoaded = true;

                // Dismiss branded loading screen (shown after login)
                try { await JS.InvokeVoidAsync("brandedLoading.dismiss"); } catch { }
            }
            catch
            {
                // localStorage may not be available during prerender
            }
        }
        else
        {
            _userName = string.Empty;
            _organizationName = "Booking Schedule System";
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var relativePath = new Uri(e.Location).AbsolutePath;
        ExtractAndSetSlugFromPath(relativePath);
    }

    private void ExtractAndSetSlugFromPath(string path)
    {
        // Extract the first segment if the URL follows /{slug}/page pattern
        var segments = path.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length >= 2)
        {
            // The first segment could be a slug if it's not a known top-level route
            var firstSegment = segments[0].ToLowerInvariant();
            var knownRoutes = new HashSet<string>
            {
                "login", "register", "dashboard", "browse-schedules", "my-bookings",
                "schedules", "providers", "customers", "organization", "subscription", "analytics",
                "settings", "profile", "onboarding", "admin", "not-found", "error",
                "register-organization", "forgot-password", "terms", "counter", "weather"
            };

            if (!knownRoutes.Contains(firstSegment))
            {
                SlugService.SetSlug(firstSegment);
            }
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo(SlugService.BuildUrl("/profile"));
    }

    private void NavigateToSettings()
    {
        Navigation.NavigateTo(SlugService.BuildUrl("/settings"));
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        var loginUrl = SlugService.BuildUrl("/login");
        SlugService.SetSlug(null);
        Navigation.NavigateTo(loginUrl, forceLoad: true);
    }
}
