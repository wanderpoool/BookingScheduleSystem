@inherits LayoutComponentBase

<MudThemeProvider @ref="@_mudThemeProvider" IsDarkMode="false" Theme="@_customTheme" />

@Body

@code {
    private MudThemeProvider? _mudThemeProvider;

    private MudTheme _customTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            // Primary Orange - Warm & Inviting
            Primary = "#E85D2A",
            PrimaryContrastText = "#FFFFFF",
            PrimaryDarken = "#C94A1D",
            PrimaryLighten = "#F28B5F",

            // Secondary Navy - Professional & Grounded
            Secondary = "#1B2D45",
            SecondaryContrastText = "#FFFFFF",
            SecondaryDarken = "#0F1D30",
            SecondaryLighten = "#3D5A80",

            // Tertiary Gold - Accent & Highlights
            Tertiary = "#FFC53D",
            TertiaryContrastText = "#1B2D45",
            TertiaryDarken = "#D9A020",
            TertiaryLighten = "#FFD97A",

            // Semantic Colors
            Success = "#10B981",
            SuccessContrastText = "#FFFFFF",
            Info = "#3B82F6",
            InfoContrastText = "#FFFFFF",
            Warning = "#F59E0B",
            WarningContrastText = "#FFFFFF",
            Error = "#EF4444",
            ErrorContrastText = "#FFFFFF",

            // Backgrounds
            Background = "#FFF8F0",
            Surface = "#FFFFFF",

            // AppBar
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1B2D45",

            // Drawer
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1B2D45",
            DrawerIcon = "#5A6B80",

            // Text
            TextPrimary = "#1B2D45",
            TextSecondary = "#5A6B80",
            TextDisabled = "#9CA3AF",

            // Borders & Dividers
            Divider = "#E8DFD5",
            DividerLight = "#F5EDE4",
            LinesDefault = "#E8DFD5",
            LinesInputs = "#D5CBC0",

            // Actions
            ActionDefault = "#5A6B80",
            ActionDisabled = "#9CA3AF",
            ActionDisabledBackground = "#FFF5EC",

            // Hover/Ripple states
            HoverOpacity = 0.04,
            RippleOpacity = 0.08
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "14px",
            DrawerWidthLeft = "280px",
            DrawerWidthRight = "360px",
            DrawerMiniWidthLeft = "64px",
            AppbarHeight = "56px"
        }
    };
}
