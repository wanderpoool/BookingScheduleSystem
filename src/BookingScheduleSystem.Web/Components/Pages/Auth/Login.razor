@page "/login"
@page "/{Slug}/login"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout EmptyLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Elevation="0" Class="pa-6 pa-sm-10" Style="width: 100%; max-width: 450px; border: 1px solid var(--mud-palette-divider); border-radius: 20px;">
        <MudStack Spacing="4">
            @* Logo/Branding *@
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2">
                <div style="width: 38px; height: 38px; background: #E85D2A; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 18px; font-family: 'Fraunces', Georgia, serif;">B</div>
                <span style="font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: 20px;">Book Me App!</span>
            </MudStack>

            @if (_companyInfo != null)
            {
                <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Business" Dense="true">
                    Signing in to <strong>@_companyInfo.Name</strong>
                </MudAlert>
            }

            <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 800; letter-spacing: -0.03em;">Welcome Back</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Sign in to continue to your account
            </MudText>

            <MudDivider />

            @* Login Method Toggle *@
            <MudStack Row="true" Justify="Justify.Center">
                <MudButton Variant="@(_activeTab == 0 ? Variant.Filled : Variant.Text)"
                           Color="@(_activeTab == 0 ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.Lock"
                           OnClick="@(() => _activeTab = 0)"
                           Style="flex: 1;">
                    Password
                </MudButton>
                <MudButton Variant="@(_activeTab == 1 ? Variant.Filled : Variant.Text)"
                           Color="@(_activeTab == 1 ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.Sms"
                           OnClick="@(() => _activeTab = 1)"
                           Style="flex: 1;">
                    OTP
                </MudButton>
            </MudStack>

            @if (_activeTab == 0)
            {
                @* Password Login Form *@
                <EditForm Model="@_loginModel" OnSubmit="HandlePasswordLogin">

                    <MudStack Spacing="3">
                        <MudStack Row="true" Justify="Justify.Center">
                            <MudRadioGroup @bind-Value="_loginModel.ContactMethod" T="string">
                                <MudRadio Value="@("email")" Color="Color.Primary">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                                        <MudText>Email</MudText>
                                    </MudStack>
                                </MudRadio>
                                <MudRadio Value="@("phone")" Color="Color.Primary">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                                        <MudText>Phone Number</MudText>
                                    </MudStack>
                                </MudRadio>
                            </MudRadioGroup>
                        </MudStack>

                        @if (_loginModel.ContactMethod == "email")
                        {
                            <MudTextField @bind-Value="_loginModel.Email"
                                          Label="Email"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Email"
                                          Required="true"
                                          RequiredError="Email is required"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Email" />
                        }
                        else
                        {
                            <div id="login-password-phone-input">
                                <MudTextField T="string"
                                              Value="@_loginModel.PhoneNumber"
                                              ValueChanged="@OnPasswordPhoneInput"
                                              Immediate="true"
                                              Label="Phone Number"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.Telephone"
                                              Required="true"
                                              Placeholder="9XX-XXX-XXXX"
                                              MaxLength="12"
                                              Adornment="Adornment.Start"
                                              AdornmentText="+63"
                                              OnBlur="FormatPasswordPhoneNumber" />
                            </div>
                        }

                        <MudTextField @bind-Value="_loginModel.Password"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Required="true"
                                      RequiredError="Password is required"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="TogglePasswordVisibility" />

                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudCheckBox T="bool" @bind-Value="_rememberMe" Label="Remember me" Color="Color.Primary" />
                            <MudLink Href="/forgot-password" Typo="Typo.body2">Forgot password?</MudLink>
                        </MudStack>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <MudText>Signing in...</MudText>
                            }
                            else
                            {
                                <MudText>Sign In</MudText>
                            }
                        </MudButton>
                    </MudStack>
                </EditForm>
            }
            else
            {
                @* OTP Login Form *@
                <MudStack Spacing="3">
                    @if (_otpStep == OtpLoginStep.SendOtp)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            We'll send a verification code to your email or phone
                        </MudText>

                        <MudRadioGroup @bind-Value="_otpContactMethod">
                            <MudRadio Value="@("email")" Color="Color.Primary">Email</MudRadio>
                            <MudRadio Value="@("phone")" Color="Color.Primary">Phone</MudRadio>
                        </MudRadioGroup>

                        @if (_otpContactMethod == "email")
                        {
                            <MudTextField @bind-Value="_otpEmail"
                                          Label="Email"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Email"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Email" />
                        }
                        else
                        {
                            <div id="login-phone-input">
                                <MudTextField T="string"
                                              Value="@_otpPhone"
                                              ValueChanged="@OnPhoneInput"
                                              Immediate="true"
                                              Label="Phone Number"
                                              Variant="Variant.Outlined"
                                              Placeholder="9XX-XXX-XXXX"
                                              MaxLength="12"
                                              InputType="InputType.Telephone"
                                              Adornment="Adornment.Start"
                                              AdornmentText="+63"
                                              OnBlur="FormatPhoneNumber" />
                            </div>
                        }

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   OnClick="SendLoginOtp"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <MudText>Sending code...</MudText>
                            }
                            else
                            {
                                <MudText>Send Verification Code</MudText>
                            }
                        </MudButton>
                    }
                    else if (_otpStep == OtpLoginStep.VerifyOtp)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Code sent to @(_otpContactMethod == "email" ? _otpEmail : $"+63 {_otpPhone}")
                        </MudAlert>

                        @if (_otpExpiresAt.HasValue)
                        {
                            var remaining = _otpExpiresAt.Value - DateTime.UtcNow;
                            @if (remaining.TotalSeconds > 0)
                            {
                                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                                    Code expires in @($"{(int)remaining.TotalMinutes}:{remaining.Seconds:D2}")
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Error">
                                    Code expired. Please request a new one.
                                </MudText>
                            }
                        }

                        <MudTextField @bind-Value="_otpCode"
                                      Label="Enter 6-digit code"
                                      Variant="Variant.Outlined"
                                      MaxLength="6"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Pin"
                                      Style="letter-spacing: 8px; font-size: 1.5rem; text-align: center;" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   OnClick="VerifyLoginOtp"
                                   Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_otpCode) || _otpCode.Length < 6)">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <MudText>Verifying...</MudText>
                            }
                            else
                            {
                                <MudText>Verify & Sign In</MudText>
                            }
                        </MudButton>

                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudButton Variant="Variant.Text" Color="Color.Default"
                                       OnClick="@(() => _otpStep = OtpLoginStep.SendOtp)"
                                       StartIcon="@Icons.Material.Filled.ArrowBack"
                                       Size="Size.Small">
                                Back
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       OnClick="SendLoginOtp"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       Size="Size.Small"
                                       Disabled="@(_isLoading || _resendCooldown > 0)">
                                @(_resendCooldown > 0 ? $"Resend in {_resendCooldown}s" : "Resend Code")
                            </MudButton>
                        </MudStack>
                    }
                </MudStack>
            }

            <MudDivider />

            <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                <MudText Typo="Typo.body2">Want to create an organization?</MudText>
                <MudLink Href="/register-organization" Typo="Typo.body2">Get started</MudLink>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>

