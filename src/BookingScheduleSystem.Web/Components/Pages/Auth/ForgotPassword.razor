@page "/forgot-password"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using BookingScheduleSystem.Contracts.Auth
@inject IAuthenticationService AuthService
@inject IOtpService OtpService
@inject NavigationManager Navigation
@inject ITenantSlugService SlugService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@layout EmptyLayout
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Elevation="0" Class="pa-10" Style="width: 100%; max-width: 450px; border: 1px solid var(--mud-palette-divider); border-radius: 20px;">
        <MudStack Spacing="4">
            @* Logo/Branding *@
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2">
                <div style="width: 38px; height: 38px; background: #E85D2A; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 18px; font-family: 'Fraunces', Georgia, serif;">B</div>
                <span style="font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: 20px;">Book Me App!</span>
            </MudStack>

            <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 800; letter-spacing: -0.03em;">Reset Password</MudText>

            @if (_step == Step.EnterContact)
            {
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    We'll send a verification code to your email or phone
                </MudText>

                <MudDivider />

                <MudRadioGroup @bind-Value="_contactMethod">
                    <MudRadio Value="@("email")" Color="Color.Primary">Email</MudRadio>
                    <MudRadio Value="@("phone")" Color="Color.Primary">Phone</MudRadio>
                </MudRadioGroup>

                @if (_contactMethod == "email")
                {
                    <MudTextField @bind-Value="_email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Required="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />
                }
                else
                {
                    <div id="forgot-phone-input">
                        <MudTextField T="string"
                                      Value="@_phone"
                                      ValueChanged="@OnPhoneInput"
                                      Immediate="true"
                                      Label="Phone Number"
                                      Variant="Variant.Outlined"
                                      Placeholder="9XX-XXX-XXXX"
                                      MaxLength="12"
                                      InputType="InputType.Telephone"
                                      Adornment="Adornment.Start"
                                      AdornmentText="+63"
                                      OnBlur="FormatPhoneNumber" />
                    </div>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="SendResetOtp"
                           Disabled="@(_isLoading || !HasValidContact)">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <MudText>Sending code...</MudText>
                    }
                    else
                    {
                        <MudText>Send Verification Code</MudText>
                    }
                </MudButton>
            }
            else if (_step == Step.VerifyOtp)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Code sent to @(_contactMethod == "email" ? _email : $"+63 {_phone}")
                </MudAlert>

                @if (_otpExpiresAt.HasValue)
                {
                    var remaining = _otpExpiresAt.Value - DateTime.UtcNow;
                    @if (remaining.TotalSeconds > 0)
                    {
                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                            Code expires in @($"{(int)remaining.TotalMinutes}:{remaining.Seconds:D2}")
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Error">
                            Code expired. Please request a new one.
                        </MudText>
                    }
                }

                <MudDivider />

                <MudTextField @bind-Value="_otpCode"
                              Label="Enter 6-digit code"
                              Variant="Variant.Outlined"
                              MaxLength="6"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Pin"
                              Style="letter-spacing: 8px; font-size: 1.5rem; text-align: center;" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="VerifyCode"
                           Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_otpCode) || _otpCode.Length < 6)">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <MudText>Verifying...</MudText>
                    }
                    else
                    {
                        <MudText>Verify Code</MudText>
                    }
                </MudButton>

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Text" Color="Color.Default"
                               OnClick="@(() => _step = Step.EnterContact)"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Size="Size.Small">
                        Back
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               OnClick="SendResetOtp"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               Size="Size.Small"
                               Disabled="@(_isLoading || _resendCooldown > 0)">
                        @(_resendCooldown > 0 ? $"Resend in {_resendCooldown}s" : "Resend Code")
                    </MudButton>
                </MudStack>
            }
            else if (_step == Step.NewPassword)
            {
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Create a new password for your account
                </MudText>

                <MudDivider />

                <MudTextField @bind-Value="_newPassword"
                              Label="New Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="Confirm Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Required="true" />

                @if (!string.IsNullOrWhiteSpace(_newPassword) && _newPassword.Length < 6)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">Password must be at least 6 characters</MudText>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="ResetPassword"
                           Disabled="@(_isLoading || !IsPasswordValid)">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <MudText>Resetting password...</MudText>
                    }
                    else
                    {
                        <MudText>Reset Password</MudText>
                    }
                </MudButton>
            }

            <MudDivider />

            <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                <MudText Typo="Typo.body2">Remember your password?</MudText>
                <MudLink Href="/login" Typo="Typo.body2">Sign in</MudLink>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private enum Step { EnterContact, VerifyOtp, NewPassword }

    private Step _step = Step.EnterContact;
    private bool _isLoading;
    private bool _showPassword;

    private string _contactMethod = "email";
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string CleanPhone => "+63" + new string(_phone.Where(char.IsDigit).ToArray());
    private string _otpCode = string.Empty;
    private string _verificationToken = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private DateTime? _otpExpiresAt;
    private int _resendCooldown;
    private System.Timers.Timer? _timer;

    private bool HasValidContact => _contactMethod == "email"
        ? !string.IsNullOrWhiteSpace(_email)
        : !string.IsNullOrWhiteSpace(_phone) && _phone.Where(char.IsDigit).Count() >= 10;

    private bool IsPasswordValid =>
        !string.IsNullOrWhiteSpace(_newPassword)
        && _newPassword.Length >= 6
        && _newPassword == _confirmPassword;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_contactMethod == "phone" && _step == Step.EnterContact)
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("phoneInput.restrict", null, "forgot-phone-input");
        }
    }

    private void OnPhoneInput(string value)
    {
        var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 10)
            digits = digits[..10];
        _phone = digits;
    }

    private void FormatPhoneNumber()
    {
        var digits = new string((_phone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 10)
            digits = digits[..10];

        _phone = digits.Length switch
        {
            > 6 => $"{digits[..3]}-{digits[3..6]}-{digits[6..]}",
            > 3 => $"{digits[..3]}-{digits[3..]}",
            _ => digits
        };
    }

    private async Task SendResetOtp()
    {
        if (!HasValidContact)
        {
            Snackbar.Add($"Please enter your {_contactMethod}.", Severity.Warning);
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var request = new SendOtpRequest
            {
                ContactMethod = _contactMethod,
                Email = _contactMethod == "email" ? _email : null,
                PhoneNumber = _contactMethod == "phone" ? CleanPhone : null,
                Purpose = "password-reset"
            };

            var result = await OtpService.SendOtpAsync(request);

            if (result.Success)
            {
                _otpExpiresAt = result.ExpiresAt;
                _otpCode = string.Empty;
                _step = Step.VerifyOtp;
                _resendCooldown = 30;
                StartCountdownTimer();
                Snackbar.Add("Verification code sent!", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Couldn't send verification code. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task VerifyCode()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var request = new VerifyOtpRequest
            {
                ContactMethod = _contactMethod,
                Email = _contactMethod == "email" ? _email : null,
                PhoneNumber = _contactMethod == "phone" ? CleanPhone : null,
                OtpCode = _otpCode,
                Purpose = "password-reset"
            };

            var result = await OtpService.VerifyOtpAsync(request);

            if (result.Success && result.IsVerified)
            {
                _verificationToken = result.VerificationToken ?? "";
                _step = Step.NewPassword;
                _timer?.Stop();
                Snackbar.Add("Code verified! Set your new password.", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Invalid code. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResetPassword()
    {
        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("Passwords do not match.", Severity.Warning);
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var request = new ResetPasswordRequest
            {
                ContactMethod = _contactMethod,
                Email = _contactMethod == "email" ? _email : null,
                PhoneNumber = _contactMethod == "phone" ? CleanPhone : null,
                OtpVerificationToken = _verificationToken,
                NewPassword = _newPassword
            };

            var success = await AuthService.ResetPasswordAsync(request);

            if (success)
            {
                Snackbar.Add("Password reset successfully! Please sign in.", Severity.Success);
                Navigation.NavigateTo(SlugService.BuildUrl("/login"));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void StartCountdownTimer()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (_, _) => InvokeAsync(() =>
        {
            if (_resendCooldown > 0) _resendCooldown--;
            StateHasChanged();
        });
        _timer.Start();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
