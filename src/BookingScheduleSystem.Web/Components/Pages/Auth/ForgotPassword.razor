@page "/forgot-password"
@rendermode InteractiveServer
@using BookingScheduleSystem.Contracts.Auth
@inject IAuthenticationService AuthService
@inject IOtpService OtpService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@layout EmptyLayout
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
    <MudPaper Elevation="0" Class="pa-10" Style="width: 100%; max-width: 450px; border: 1px solid var(--mud-palette-divider); border-radius: 20px;">
        <MudStack Spacing="4">
            @* Logo/Branding *@
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2">
                <div style="width: 38px; height: 38px; background: #E85D2A; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 18px; font-family: 'Fraunces', Georgia, serif;">B</div>
                <span style="font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: 20px;">Book Me App!</span>
            </MudStack>

            <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 800; letter-spacing: -0.03em;">Reset Password</MudText>

            @if (_step == Step.EnterEmail)
            {
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Enter your email and we'll send you a verification code
                </MudText>

                <MudDivider />

                <MudTextField @bind-Value="_email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Required="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="SendResetOtp"
                           Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_email))">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <MudText>Sending code...</MudText>
                    }
                    else
                    {
                        <MudText>Send Verification Code</MudText>
                    }
                </MudButton>
            }
            else if (_step == Step.VerifyOtp)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Code sent to @_email
                </MudAlert>

                @if (_otpExpiresAt.HasValue)
                {
                    var remaining = _otpExpiresAt.Value - DateTime.UtcNow;
                    @if (remaining.TotalSeconds > 0)
                    {
                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                            Code expires in @($"{(int)remaining.TotalMinutes}:{remaining.Seconds:D2}")
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Error">
                            Code expired. Please request a new one.
                        </MudText>
                    }
                }

                <MudDivider />

                <MudTextField @bind-Value="_otpCode"
                              Label="Enter 6-digit code"
                              Variant="Variant.Outlined"
                              MaxLength="6"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Pin"
                              Style="letter-spacing: 8px; font-size: 1.5rem; text-align: center;" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="VerifyCode"
                           Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_otpCode) || _otpCode.Length < 6)">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <MudText>Verifying...</MudText>
                    }
                    else
                    {
                        <MudText>Verify Code</MudText>
                    }
                </MudButton>

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Text" Color="Color.Default"
                               OnClick="@(() => _step = Step.EnterEmail)"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Size="Size.Small">
                        Back
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Primary"
                               OnClick="SendResetOtp"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               Size="Size.Small"
                               Disabled="@_isLoading">
                        Resend Code
                    </MudButton>
                </MudStack>
            }
            else if (_step == Step.NewPassword)
            {
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Create a new password for your account
                </MudText>

                <MudDivider />

                <MudTextField @bind-Value="_newPassword"
                              Label="New Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="Confirm Password"
                              Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Required="true" />

                @if (!string.IsNullOrWhiteSpace(_newPassword) && _newPassword.Length < 6)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">Password must be at least 6 characters</MudText>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="ResetPassword"
                           Disabled="@(_isLoading || !IsPasswordValid)">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                        <MudText>Resetting password...</MudText>
                    }
                    else
                    {
                        <MudText>Reset Password</MudText>
                    }
                </MudButton>
            }

            <MudDivider />

            <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                <MudText Typo="Typo.body2">Remember your password?</MudText>
                <MudLink Href="/login" Typo="Typo.body2">Sign in</MudLink>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private enum Step { EnterEmail, VerifyOtp, NewPassword }

    private Step _step = Step.EnterEmail;
    private bool _isLoading;
    private bool _showPassword;

    private string _email = string.Empty;
    private string _otpCode = string.Empty;
    private string _verificationToken = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private DateTime? _otpExpiresAt;
    private System.Timers.Timer? _timer;

    private bool IsPasswordValid =>
        !string.IsNullOrWhiteSpace(_newPassword)
        && _newPassword.Length >= 6
        && _newPassword == _confirmPassword;

    private async Task SendResetOtp()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            Snackbar.Add("Please enter your email.", Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            var request = new SendOtpRequest
            {
                ContactMethod = "email",
                Email = _email,
                Purpose = "password-reset"
            };

            var result = await OtpService.SendOtpAsync(request);

            if (result.Success)
            {
                _otpExpiresAt = result.ExpiresAt;
                _otpCode = string.Empty;
                _step = Step.VerifyOtp;
                StartCountdownTimer();
                Snackbar.Add("Verification code sent!", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Couldn't send verification code. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task VerifyCode()
    {
        _isLoading = true;

        try
        {
            var request = new VerifyOtpRequest
            {
                ContactMethod = "email",
                Email = _email,
                OtpCode = _otpCode,
                Purpose = "password-reset"
            };

            var result = await OtpService.VerifyOtpAsync(request);

            if (result.Success && result.IsVerified)
            {
                _verificationToken = result.VerificationToken ?? "";
                _step = Step.NewPassword;
                _timer?.Stop();
                Snackbar.Add("Code verified! Set your new password.", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message ?? "Invalid code. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResetPassword()
    {
        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("Passwords do not match.", Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            var request = new ResetPasswordRequest
            {
                Email = _email,
                OtpVerificationToken = _verificationToken,
                NewPassword = _newPassword
            };

            var success = await AuthService.ResetPasswordAsync(request);

            if (success)
            {
                Snackbar.Add("Password reset successfully! Please sign in.", Severity.Success);
                Navigation.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartCountdownTimer()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        _timer.Start();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
