@page "/register-organization"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using BookingScheduleSystem.Contracts.Auth
@using BookingScheduleSystem.Contracts.Tenants
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject HttpClient Http
@layout EmptyLayout

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4" Style="min-height: 100vh;">
    <MudPaper Elevation="3" Class="pa-4 pa-sm-6">
        <MudStack Spacing="3">
            @* Header *@
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2">
                <div style="width: 38px; height: 38px; background: #E85D2A; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 18px; font-family: 'Fraunces', Georgia, serif;">B</div>
                <span style="font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: 20px;">Book Me App!</span>
            </MudStack>

            <MudText Typo="Typo.h5" Align="Align.Center">Create Your Organization</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                Start your 7-day free trial • 2 bookings per day during trial
            </MudText>

            <MudDivider />

            @* Stepper with Custom Booking-themed Icons *@
            <MudStepper @bind-ActiveIndex="_activeStepIndex"
                        Class="custom-stepper">

                @* Step 1: Organization Details *@
                <MudStep Title="Organization" Icon="@Icons.Material.Filled.Store">
                    <ChildContent>
                        <MudStack Spacing="2" Class="mt-4">
                            <MudText Typo="Typo.h6">Organization Information</MudText>

                            <MudTextField @bind-Value="_model.Name"
                                          Label="Organization Name"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          HelperText="Your business or organization name"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Store"
                                          OnBlur="@GenerateSubdomainFromName" />

                            <MudTextField @bind-Value="_model.Description"
                                          Label="Description (Optional)"
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          HelperText="Brief description of your organization" />

                            @* OpenStreetMap Nominatim Location Autocomplete *@
                            <MudAutocomplete T="string"
                                             @bind-Value="_model.Location"
                                             Label="Location"
                                             Variant="Variant.Outlined"
                                             SearchFunc="@SearchLocations"
                                             Placeholder="Start typing your address..."
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.LocationOn"
                                             AdornmentColor="Color.Primary"
                                             HelperText="Search for your business location (powered by OpenStreetMap)"
                                             MinCharacters="3"
                                             ResetValueOnEmptyText="false"
                                             CoerceText="true"
                                             CoerceValue="false"
                                             DebounceInterval="500" />

                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2">
                                        <strong>Auto-generated identifier:</strong> @GetSubdomainPreview()
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        This will be used for your organization's unique URL
                                    </MudText>
                                </MudStack>
                            </MudAlert>

                            @* Step Navigation *@
                            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="() => NextStep(0)"
                                           EndIcon="@Icons.Material.Filled.ArrowForward">
                                    Next
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </ChildContent>
                </MudStep>

                @* Step 2: Owner Details *@
                <MudStep Title="Your Info" Icon="@Icons.Material.Filled.Badge">
                    <ChildContent>
                        <MudStack Spacing="2" Class="mt-4">
                            <MudText Typo="Typo.h6">Owner/Admin Account</MudText>

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.FirstName"
                                                  Label="First Name"
                                                  Variant="Variant.Outlined"
                                                  Required="true" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.LastName"
                                                  Label="Last Name"
                                                  Variant="Variant.Outlined"
                                                  Required="true" />
                                </MudItem>
                            </MudGrid>

                            <MudTextField @bind-Value="_model.Email"
                                          Label="Email"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Email"
                                          Required="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Email" />

                            <MudTextField @bind-Value="_model.Password"
                                          Label="Password"
                                          Variant="Variant.Outlined"
                                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                          Required="true"
                                          HelperText="Minimum 6 characters"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                          OnAdornmentClick="TogglePasswordVisibility" />

                            <MudTextField @bind-Value="_model.ConfirmPassword"
                                          Label="Confirm Password"
                                          Variant="Variant.Outlined"
                                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                          Required="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />

                            @* Step Navigation *@
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           OnClick="() => PreviousStep()"
                                           StartIcon="@Icons.Material.Filled.ArrowBack">
                                    Back
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="() => NextStep(1)"
                                           EndIcon="@Icons.Material.Filled.ArrowForward">
                                    Next
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </ChildContent>
                </MudStep>

                @* Step 3: Operating Hours *@
                <MudStep Title="Hours" Icon="@Icons.Material.Filled.Schedule">
                    <ChildContent>
                        <MudStack Spacing="2" Class="mt-4">
                            <MudText Typo="Typo.h6">Operating Hours</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Set your business hours (You can update this later)
                            </MudText>

                            <MudAlert Severity="Severity.Info" Dense="true">
                                Default: Monday-Friday 9:00 AM - 5:00 PM
                            </MudAlert>

                            <MudCheckBox T="bool" @bind-Value="_useDefaultHours" Label="Use default hours for now" Color="Color.Primary" />

                            @if (!_useDefaultHours)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    (Advanced operating hours can be configured after registration)
                                </MudText>
                            }

                            @* Step Navigation *@
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           OnClick="() => PreviousStep()"
                                           StartIcon="@Icons.Material.Filled.ArrowBack">
                                    Back
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="() => NextStep(2)"
                                           EndIcon="@Icons.Material.Filled.ArrowForward">
                                    Review
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </ChildContent>
                </MudStep>

                @* Step 4: Review & Legal *@
                <MudStep Title="Review" Icon="@Icons.Material.Filled.Celebration">
                    <ChildContent>
                        <MudStack Spacing="3" Class="mt-4">
                            <MudText Typo="Typo.h6">Review & Confirm</MudText>

                            @* Organization Summary *@
                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Organization</MudText>
                                    <MudText Typo="Typo.body2"><strong>Name:</strong> @_model.Name</MudText>
                                    <MudText Typo="Typo.body2"><strong>Subdomain:</strong> @_model.Subdomain</MudText>
                                    <MudText Typo="Typo.body2"><strong>Location:</strong> @(_model.Location ?? "Not specified")</MudText>
                                </MudStack>
                            </MudPaper>

                            @* Owner Summary *@
                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Owner/Admin</MudText>
                                    <MudText Typo="Typo.body2"><strong>Name:</strong> @_model.FirstName @_model.LastName</MudText>
                                    <MudText Typo="Typo.body2"><strong>Email:</strong> @_model.Email</MudText>
                                </MudStack>
                            </MudPaper>

                            @* Trial Information *@
                            <MudAlert Severity="Severity.Success" Dense="true">
                                <MudText Typo="Typo.body2">
                                    <strong>7-Day Free Trial Included!</strong><br />
                                    • 2 bookings per day during trial<br />
                                    • Full access to all features<br />
                                    • No credit card required
                                </MudText>
                            </MudAlert>

                            @* Philippine Data Privacy Act Compliance *@
                            <MudPaper Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.PrivacyTip" Size="Size.Small" /> Legal Agreements
                                    </MudText>

                                    <MudCheckBox T="bool" @bind-Value="_acceptTerms" Color="Color.Primary" Dense="true" Required="true">
                                        <MudText Typo="Typo.body2">
                                            I have read and agree to the <MudLink Href="/terms" Target="_blank">Terms and Conditions</MudLink>
                                        </MudText>
                                    </MudCheckBox>

                                    <MudCheckBox T="bool" @bind-Value="_acceptDataPrivacy" Color="Color.Primary" Dense="true" Required="true">
                                        <MudText Typo="Typo.body2">
                                            I consent to the collection and processing of my personal data in accordance with the
                                            <MudLink Href="/privacy" Target="_blank">Privacy Policy</MudLink> and the
                                            <strong>Data Privacy Act of 2012 (Republic Act No. 10173)</strong> of the Philippines
                                        </MudText>
                                    </MudCheckBox>

                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                        <MudText Typo="Typo.caption">
                                            Your data will be processed securely and in compliance with Philippine data protection laws.
                                            You have the right to access, correct, and request deletion of your personal information.
                                        </MudText>
                                    </MudAlert>
                                </MudStack>
                            </MudPaper>

                            @* Step Navigation *@
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Spacing="2" Class="mt-2">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           OnClick="() => PreviousStep()"
                                           StartIcon="@Icons.Material.Filled.ArrowBack"
                                           Disabled="@_isLoading">
                                    Back
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           Style="flex: 1;"
                                           Size="Size.Large"
                                           OnClick="HandleSubmit"
                                           Disabled="@(!_acceptTerms || !_acceptDataPrivacy || _isLoading)">
                                @if (_isLoading)
                                {
                                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                    <MudText>Creating Organization...</MudText>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Celebration" Class="mr-2" />
                                    <MudText>Create Organization & Start Trial</MudText>
                                }
                            </MudButton>
                            </MudStack>
                        </MudStack>
                    </ChildContent>
                </MudStep>
            </MudStepper>

            <MudDivider Class="mt-4" />

            <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="flex-wrap">
                <MudText Typo="Typo.body2">Already have an account?</MudText>
                <MudLink Href="/login" Typo="Typo.body2">Sign in</MudLink>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private int _activeStepIndex = 0;
    private OrganizationSetupModel _model = new();
    private bool _showPassword = false;
    private bool _useDefaultHours = true;
    private bool _acceptTerms = false;
    private bool _acceptDataPrivacy = false;
    private bool _isLoading = false;

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private void GenerateSubdomainFromName()
    {
        if (!string.IsNullOrWhiteSpace(_model.Name))
        {
            // Auto-generate subdomain from organization name
            _model.Subdomain = System.Text.RegularExpressions.Regex.Replace(
                _model.Name.ToLowerInvariant(),
                @"[^a-z0-9\s-]", "") // Remove special characters
                .Replace(" ", "-")   // Replace spaces with hyphens
                .Replace("--", "-")  // Replace double hyphens with single
                .Trim('-');          // Remove leading/trailing hyphens
        }
    }

    private string GetSubdomainPreview()
    {
        if (string.IsNullOrWhiteSpace(_model.Subdomain))
        {
            return "your-organization";
        }
        return _model.Subdomain;
    }

    // OpenStreetMap Nominatim location search
    private async Task<IEnumerable<string>> SearchLocations(string searchText, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(searchText) || searchText.Length < 3)
        {
            return Array.Empty<string>();
        }

        try
        {
            // Nominatim API - Free geocoding service by OpenStreetMap
            // Restrict search to Philippines (countrycodes=ph)
            var url = $"https://nominatim.openstreetmap.org/search?q={Uri.EscapeDataString(searchText)}&countrycodes=ph&format=json&addressdetails=1&limit=5";

            // Add User-Agent header as required by Nominatim usage policy
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Add("User-Agent", "BookMeApp/1.0");

            var response = await Http.SendAsync(request, cancellationToken);
            response.EnsureSuccessStatusCode();

            var results = await response.Content.ReadFromJsonAsync<List<NominatimResult>>(cancellationToken: cancellationToken);

            if (results != null && results.Any())
            {
                return results.Select(r => r.DisplayName ?? r.Name ?? "Unknown location").ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Location search error: {ex.Message}");
        }

        return Array.Empty<string>();
    }

    // Nominatim API response model
    private class NominatimResult
    {
        [JsonPropertyName("display_name")]
        public string? DisplayName { get; set; }

        [JsonPropertyName("name")]
        public string? Name { get; set; }

        [JsonPropertyName("lat")]
        public string? Latitude { get; set; }

        [JsonPropertyName("lon")]
        public string? Longitude { get; set; }
    }

    private void NextStep(int currentStepIndex)
    {
        if (!ValidateCurrentStep(currentStepIndex))
            return;

        _activeStepIndex++;
    }

    private void PreviousStep()
    {
        if (_activeStepIndex > 0)
            _activeStepIndex--;
    }

    private bool ValidateCurrentStep(int stepIndex)
    {
        // Validate Step 1: Organization Details
        if (stepIndex == 0)
        {
            if (string.IsNullOrWhiteSpace(_model.Name))
            {
                Snackbar.Add("Organization name is required", Severity.Warning);
                return false;
            }

            // Auto-generate subdomain if not present
            if (string.IsNullOrWhiteSpace(_model.Subdomain))
            {
                GenerateSubdomainFromName();
            }

            // Validate subdomain format
            if (string.IsNullOrWhiteSpace(_model.Subdomain) ||
                !System.Text.RegularExpressions.Regex.IsMatch(_model.Subdomain, @"^[a-z0-9-]+$"))
            {
                Snackbar.Add("Unable to generate a valid identifier from organization name. Please use letters and numbers only.", Severity.Warning);
                return false;
            }
        }

        // Validate Step 2: Owner Details
        if (stepIndex == 1)
        {
            if (string.IsNullOrWhiteSpace(_model.FirstName) || string.IsNullOrWhiteSpace(_model.LastName))
            {
                Snackbar.Add("First name and last name are required", Severity.Warning);
                return false;
            }

            if (string.IsNullOrWhiteSpace(_model.Email))
            {
                Snackbar.Add("Email is required", Severity.Warning);
                return false;
            }

            if (string.IsNullOrWhiteSpace(_model.Password) || _model.Password.Length < 6)
            {
                Snackbar.Add("Password must be at least 6 characters", Severity.Warning);
                return false;
            }

            if (_model.Password != _model.ConfirmPassword)
            {
                Snackbar.Add("Passwords do not match", Severity.Warning);
                return false;
            }
        }

        // Step 3 (Operating Hours) - no validation needed
        return true;
    }

    private async Task HandleSubmit()
    {
        if (!_acceptTerms)
        {
            Snackbar.Add("Please accept the Terms and Conditions", Severity.Warning);
            return;
        }

        if (!_acceptDataPrivacy)
        {
            Snackbar.Add("Please consent to the Data Privacy Policy", Severity.Warning);
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            // Step 1: Register the owner/admin user as a provider
            var registerRequest = new RegisterUserRequest
            {
                Email = _model.Email,
                Password = _model.Password,
                FirstName = _model.FirstName,
                LastName = _model.LastName,
                IsProvider = true // Mark as provider to allow organization creation
            };

            var authResult = await AuthService.RegisterAsync(registerRequest);

            // Step 2: Create the organization
            var defaultOperatingHours = _useDefaultHours ?
                "{\"Monday\":{\"IsOpen\":true,\"OpenTime\":\"09:00\",\"CloseTime\":\"17:00\"},\"Tuesday\":{\"IsOpen\":true,\"OpenTime\":\"09:00\",\"CloseTime\":\"17:00\"},\"Wednesday\":{\"IsOpen\":true,\"OpenTime\":\"09:00\",\"CloseTime\":\"17:00\"},\"Thursday\":{\"IsOpen\":true,\"OpenTime\":\"09:00\",\"CloseTime\":\"17:00\"},\"Friday\":{\"IsOpen\":true,\"OpenTime\":\"09:00\",\"CloseTime\":\"17:00\"},\"Saturday\":{\"IsOpen\":false},\"Sunday\":{\"IsOpen\":false}}"
                : null;

            var orgRequest = new CreateOrganizationRequest
            {
                Name = _model.Name,
                Subdomain = _model.Subdomain,
                Description = _model.Description,
                Location = _model.Location,
                OperatingHours = defaultOperatingHours
            };

            var orgResult = await AuthService.CreateOrganizationAsync(orgRequest);

            if (orgResult != null)
            {
                // Re-login to get a fresh token with TenantId and Provider role
                await AuthService.LoginAsync(new LoginRequest
                {
                    Email = _model.Email,
                    Password = _model.Password
                });

                Snackbar.Add($"Welcome to {orgResult.Name}! Your 7-day trial has started.", Severity.Success);
                await Task.Delay(1500);
                var dashboardUrl = !string.IsNullOrEmpty(orgResult.Subdomain)
                    ? $"/{orgResult.Subdomain}/dashboard"
                    : "/dashboard";
                Navigation.NavigateTo(dashboardUrl);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
