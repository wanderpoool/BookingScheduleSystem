@page "/register"
@page "/{Slug}/register"
@rendermode InteractiveServer
@using BookingScheduleSystem.Contracts.Auth
@using BookingScheduleSystem.Contracts.Tenants
@using BookingScheduleSystem.Web.Services
@inject IAuthenticationService AuthService
@inject IOtpService OtpService
@inject ITenantService TenantService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@layout EmptyLayout
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center py-4" Style="min-height: 100vh;">
    <MudPaper Elevation="3" Class="pa-4 pa-sm-6 pa-md-8" Style="width: 100%; max-width: 500px;">
        <MudStack Spacing="3">
            @* Logo/Branding *@
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2">
                <div style="width: 38px; height: 38px; background: #E85D2A; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 18px; font-family: 'Fraunces', Georgia, serif;">B</div>
                <span style="font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: 20px;">Book Me App!</span>
            </MudStack>

            @if (_companyInfo != null)
            {
                <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Business" Dense="true">
                    Registering with <strong>@_companyInfo.Name</strong>
                </MudAlert>
            }

            <MudText Typo="Typo.h5" Align="Align.Center">Create Account</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                @if (_currentStep == RegistrationStep.PersonalInfo)
                {
                    <text>Step 1: Personal Information</text>
                }
                else if (_currentStep == RegistrationStep.OtpVerification)
                {
                    <text>Step 2: Verify Your Identity</text>
                }
                else
                {
                    <text>Step 3: Complete Registration</text>
                }
            </MudText>

            <MudDivider />

            @* Registration Form *@
            <EditForm Model="@_registerModel" OnValidSubmit="HandleRegistrationStep">
                <DataAnnotationsValidator />

                <MudStack Spacing="2">
                    @if (_currentStep == RegistrationStep.PersonalInfo)
                    {
                        @* Step 1: Personal Information *@
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_registerModel.FirstName"
                                              Label="First Name"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              For="@(() => _registerModel.FirstName)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_registerModel.LastName"
                                              Label="Last Name"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              For="@(() => _registerModel.LastName)" />
                            </MudItem>
                        </MudGrid>

                        @* Contact Method Selection *@
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Choose Verification Method</MudText>
                        <MudRadioGroup @bind-Value="_registerModel.ContactMethod" T="string">
                            <MudRadio Value="@("email")" Color="Color.Primary">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />
                                    <MudText>Email Address</MudText>
                                </MudStack>
                            </MudRadio>
                            <MudRadio Value="@("phone")" Color="Color.Primary">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                                    <MudText>Phone Number (SMS)</MudText>
                                </MudStack>
                            </MudRadio>
                        </MudRadioGroup>

                        @if (_registerModel.ContactMethod == "email")
                        {
                            <MudTextField @bind-Value="_registerModel.Email"
                                          Label="Email"
                                          Variant="Variant.Outlined"
                                          InputType="InputType.Email"
                                          Required="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Email" />
                        }
                        else
                        {
                            <div id="register-phone-input">
                                <MudTextField T="string"
                                              Value="@_registerModel.PhoneNumber"
                                              ValueChanged="@OnPhoneInput"
                                              Immediate="true"
                                              Label="Phone Number"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.Telephone"
                                              Required="true"
                                              Placeholder="9XX-XXX-XXXX"
                                              MaxLength="12"
                                              Adornment="Adornment.Start"
                                              AdornmentText="+63"
                                              OnBlur="FormatPhoneNumber" />
                            </div>
                        }

                        <MudTextField @bind-Value="_registerModel.Password"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Required="true"
                                      For="@(() => _registerModel.Password)"
                                      HelperText="Minimum 6 characters"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="TogglePasswordVisibility" />

                        <MudTextField @bind-Value="_registerModel.ConfirmPassword"
                                      Label="Confirm Password"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Required="true"
                                      For="@(() => _registerModel.ConfirmPassword)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <MudText>Processing...</MudText>
                            }
                            else
                            {
                                <MudText>Continue to Verification</MudText>
                            }
                        </MudButton>
                    }
                    else if (_currentStep == RegistrationStep.OtpVerification)
                    {
                        @* Step 2: OTP Verification *@
                        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Security">
                            We've sent a 6-digit verification code to your @(_registerModel.ContactMethod == "email" ? "email" : "phone number").
                        </MudAlert>

                        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                            @if (_registerModel.ContactMethod == "email")
                            {
                                <text>Check your email: <strong>@_registerModel.Email</strong></text>
                            }
                            else
                            {
                                <text>Check your phone: <strong>+63 @_registerModel.PhoneNumber</strong>
                                </text>
                            }
                        </MudText>

                        <MudTextField @bind-Value="_registerModel.OtpCode"
                                      Label="Enter 6-Digit Code"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Number"
                                      Required="true"
                                      MaxLength="6"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Pin"
                                      Style="text-align: center; font-size: 24px; letter-spacing: 8px;"
                                      Placeholder="000000" />

                        @if (_otpExpiresAt.HasValue)
                        {
                            var remaining = (_otpExpiresAt.Value - DateTime.UtcNow).TotalSeconds;
                            if (remaining > 0)
                            {
                                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                                    Code expires in <strong>@(Math.Ceiling(remaining / 60)):00 minutes</strong>
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Error">
                                    Code has expired. Please request a new one.
                                </MudText>
                            }
                        }

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_registerModel.OtpCode) || _registerModel.OtpCode.Length != 6)">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <MudText>Verifying...</MudText>
                            }
                            else
                            {
                                <MudText>Verify Code</MudText>
                            }
                        </MudButton>

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   FullWidth="true"
                                   OnClick="ResendOtp"
                                   Disabled="@(_isLoading || _resendCooldown > 0)">
                            @(_resendCooldown > 0 ? $"Resend in {_resendCooldown}s" : "Didn't receive the code? Resend")
                        </MudButton>

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   FullWidth="true"
                                   OnClick="GoBackToPersonalInfo"
                                   Disabled="@_isLoading">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="mr-2" /> Change Contact Method
                        </MudButton>
                    }
                    else
                    {
                        @* Step 3: Terms and Conditions *@
                        <MudPaper Elevation="0" Class="pa-3" Style="background-color: var(--mud-palette-background-grey);">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Align="Align.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.PrivacyTip" Size="Size.Small" /> Legal Agreements
                                </MudText>

                                <MudCheckBox T="bool" @bind-Value="_acceptTerms" Color="Color.Primary" Dense="true" Required="true">
                                    <MudText Typo="Typo.body2">
                                        I have read and agree to the <MudLink Href="/terms" Target="_blank">Terms and Conditions</MudLink>
                                    </MudText>
                                </MudCheckBox>

                                <MudCheckBox T="bool" @bind-Value="_acceptDataPrivacy" Color="Color.Primary" Dense="true" Required="true">
                                    <MudText Typo="Typo.body2">
                                        I consent to the collection and processing of my personal data in accordance with the
                                        <MudLink Href="/privacy" Target="_blank">Privacy Policy</MudLink> and the
                                        <strong>Data Privacy Act of 2012 (Republic Act No. 10173)</strong> of the Philippines
                                    </MudText>
                                </MudCheckBox>

                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                    <MudText Typo="Typo.caption">
                                        Your data will be processed securely and in compliance with Philippine data protection laws.
                                        You have the right to access, correct, and request deletion of your personal information.
                                    </MudText>
                                </MudAlert>
                            </MudStack>
                        </MudPaper>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="@(!_acceptTerms || !_acceptDataPrivacy || _isLoading)">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <MudText>Creating Account...</MudText>
                            }
                            else
                            {
                                <MudText>Create Account</MudText>
                            }
                        </MudButton>
                    }

                    <MudDivider />

                    <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="flex-wrap">
                        <MudText Typo="Typo.body2">Already have an account?</MudText>
                        <MudLink Href="@GetLoginUrl()" Typo="Typo.body2">Sign in</MudLink>
                    </MudStack>

                    <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="flex-wrap">
                        <MudText Typo="Typo.body2">Want to start your own?</MudText>
                        <MudLink Href="/register-organization" Typo="Typo.body2">Create Organization</MudLink>
                    </MudStack>
                </MudStack>
            </EditForm>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public string? Slug { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Company { get; set; }

    private RegisterFormModel _registerModel = new();
    private bool _showPassword = false;
    private bool _acceptTerms = false;
    private bool _acceptDataPrivacy = false;
    private bool _isLoading = false;
    private RegistrationStep _currentStep = RegistrationStep.PersonalInfo;
    private DateTime? _otpExpiresAt;
    private int _resendCooldown;
    private System.Timers.Timer? _timer;
    private TenantResponse? _companyInfo;

    private enum RegistrationStep
    {
        PersonalInfo,
        OtpVerification,
        TermsAndConditions
    }

    protected override async Task OnInitializedAsync()
    {
        // Start a timer to update OTP countdown and resend cooldown
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (s, e) => InvokeAsync(() =>
        {
            if (_resendCooldown > 0) _resendCooldown--;
            StateHasChanged();
        });
        _timer.Start();

        // Priority 1: Slug from URL route parameter
        if (!string.IsNullOrWhiteSpace(Slug))
        {
            _companyInfo = await TenantService.GetTenantBySubdomainAsync(Slug);
        }
        // Priority 2: Legacy ?company={guid} query parameter (backward compat)
        else if (!string.IsNullOrWhiteSpace(Company) && Guid.TryParse(Company, out var companyGuid))
        {
            _companyInfo = await TenantService.GetTenantAsync(companyGuid);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_registerModel.ContactMethod == "phone" && _currentStep == RegistrationStep.PersonalInfo)
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("phoneInput.restrict", null, "register-phone-input");
        }
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private string CleanPhone => "+63" + new string((_registerModel.PhoneNumber ?? "").Where(char.IsDigit).ToArray());

    private void OnPhoneInput(string value)
    {
        var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 10)
            digits = digits[..10];
        _registerModel.PhoneNumber = digits;
    }

    private void FormatPhoneNumber()
    {
        var digits = new string((_registerModel.PhoneNumber ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length > 10)
            digits = digits[..10];

        _registerModel.PhoneNumber = digits.Length switch
        {
            > 6 => $"{digits[..3]}-{digits[3..6]}-{digits[6..]}",
            > 3 => $"{digits[..3]}-{digits[3..]}",
            _ => digits
        };
    }

    private async Task HandleRegistrationStep()
    {
        if (_currentStep == RegistrationStep.PersonalInfo)
        {
            await SendOtpForVerification();
        }
        else if (_currentStep == RegistrationStep.OtpVerification)
        {
            await VerifyOtpCode();
        }
        else if (_currentStep == RegistrationStep.TermsAndConditions)
        {
            await CompleteRegistration();
        }
    }

    private async Task SendOtpForVerification()
    {
        _isLoading = true;

        try
        {
            // Validate contact method
            if (_registerModel.ContactMethod == "email" && string.IsNullOrWhiteSpace(_registerModel.Email))
            {
                Snackbar.Add("Please enter your email address", Severity.Warning);
                _isLoading = false;
                return;
            }

            if (_registerModel.ContactMethod == "phone" && string.IsNullOrWhiteSpace(_registerModel.PhoneNumber))
            {
                Snackbar.Add("Please enter your phone number", Severity.Warning);
                _isLoading = false;
                return;
            }

            var request = new SendOtpRequest
            {
                ContactMethod = _registerModel.ContactMethod,
                Email = _registerModel.Email,
                PhoneNumber = _registerModel.ContactMethod == "phone" ? CleanPhone : null,
                Purpose = "registration"
            };

            var response = await OtpService.SendOtpAsync(request);

            if (response.Success)
            {
                _otpExpiresAt = response.ExpiresAt;
                _resendCooldown = 30;
                _currentStep = RegistrationStep.OtpVerification;
                Snackbar.Add(response.Message ?? "OTP sent successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add(response.Message ?? "We couldn't send your verification code. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task VerifyOtpCode()
    {
        _isLoading = true;

        try
        {
            var request = new VerifyOtpRequest
            {
                ContactMethod = _registerModel.ContactMethod,
                Email = _registerModel.Email,
                PhoneNumber = _registerModel.ContactMethod == "phone" ? CleanPhone : null,
                OtpCode = _registerModel.OtpCode,
                Purpose = "registration"
            };

            var response = await OtpService.VerifyOtpAsync(request);

            if (response.Success && response.IsVerified)
            {
                _registerModel.OtpVerificationToken = response.VerificationToken;
                _currentStep = RegistrationStep.TermsAndConditions;
                Snackbar.Add("Verification successful! Please accept the terms to continue.", Severity.Success);
            }
            else
            {
                Snackbar.Add(response.Message ?? "The code you entered is incorrect. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CompleteRegistration()
    {
        if (!_acceptTerms)
        {
            Snackbar.Add("Please accept the Terms and Conditions", Severity.Warning);
            return;
        }

        if (!_acceptDataPrivacy)
        {
            Snackbar.Add("Please consent to the Data Privacy Policy", Severity.Warning);
            return;
        }

        _isLoading = true;

        try
        {
            var registerRequest = new RegisterUserRequest
            {
                Email = _registerModel.ContactMethod == "email" ? _registerModel.Email : null,
                PhoneNumber = _registerModel.ContactMethod == "phone" ? CleanPhone : null,
                Password = _registerModel.Password,
                FirstName = _registerModel.FirstName,
                LastName = _registerModel.LastName,
                CreationCode = string.IsNullOrWhiteSpace(_registerModel.CreationCode) ? null : _registerModel.CreationCode,
                TenantId = _companyInfo?.Id,
                OtpVerificationToken = _registerModel.OtpVerificationToken
            };

            var result = await AuthService.RegisterAsync(registerRequest);

            if (result != null)
            {
                Snackbar.Add($"Welcome, {result.FirstName}! Account created successfully.", Severity.Success);
                var slug = Slug ?? _companyInfo?.Subdomain;
                if (_companyInfo != null)
                {
                    Navigation.NavigateTo(slug != null ? $"/{slug}/onboarding" : "/onboarding");
                }
                else
                {
                    Navigation.NavigateTo(slug != null ? $"/{slug}/dashboard" : "/dashboard");
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResendOtp()
    {
        _registerModel.OtpCode = string.Empty;
        await SendOtpForVerification();
    }

    private void GoBackToPersonalInfo()
    {
        _currentStep = RegistrationStep.PersonalInfo;
        _registerModel.OtpCode = string.Empty;
        _otpExpiresAt = null;
    }

    private string GetLoginUrl()
    {
        var slug = Slug ?? _companyInfo?.Subdomain;
        if (!string.IsNullOrEmpty(slug))
            return $"/{slug}/login";
        if (_companyInfo != null && !string.IsNullOrEmpty(Company))
            return $"/login?company={Company}";
        return "/login";
    }
}
