@page "/profile"
@page "/{Slug}/profile"
@rendermode InteractiveServer
@attribute [Authorize]

<MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px; overflow: hidden;">
    <div class="d-flex align-center pa-4 px-5" style="border-bottom: 1px solid var(--mud-palette-divider);">
        <div class="mr-auto">
            <MudText Typo="Typo.h6" Style="font-weight: 700;">My Profile</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">View and edit your profile</MudText>
        </div>
    </div>

    <div class="pa-5">
        @if (_isLoading)
        {
            <MudStack Spacing="3">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="64px" Height="64px" />
                <MudSkeleton Width="40%" Height="20px" />
                <MudSkeleton Width="60%" Height="16px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius: 14px;" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius: 14px;" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius: 14px;" />
            </MudStack>
        }
        else if (_user == null)
        {
            <MudAlert Severity="Severity.Warning">Unable to load your profile. Please try signing in again.</MudAlert>
        }
        else
        {
            <MudStack Spacing="3">
                @* Avatar + name *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Style="font-size: 1.5rem;">
                        @(_user.FirstName.Length > 0 ? _user.FirstName[0].ToString().ToUpper() : "?")
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6">@_user.FirstName @_user.LastName</MudText>
                        <MudStack Row="true" Spacing="1">
                            @if (_user.IsGlobalAdmin)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">Admin</MudChip>
                            }
                            else if (_user.IsProvider)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Provider</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">Customer</MudChip>
                            }
                        </MudStack>
                    </div>
                </MudStack>

                <MudDivider />

                @if (!_isEditing)
                {
                    @* View mode *@
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">@_user.Email</MudText>
                        </MudStack>

                        @if (!string.IsNullOrWhiteSpace(_user.PhoneNumber))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">@_user.PhoneNumber</MudText>
                            </MudStack>
                        }

                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Member since @_user.CreatedAt.ToString("MMMM dd, yyyy")
                        </MudText>
                    </MudStack>

                    @if (_user.IsProvider)
                    {
                        <MudDivider />

                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Booking Preferences</MudText>

                        <MudPaper Elevation="0" Class="pa-3 pa-sm-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@(_user.AutoAcceptBookings ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.HourglassTop)"
                                             Color="@(_user.AutoAcceptBookings ? Color.Success : Color.Warning)"
                                             Size="Size.Small" />
                                    <div>
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">Auto-Accept Bookings</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @(_user.AutoAcceptBookings
                                                ? "New bookings are automatically confirmed"
                                                : "New bookings require your manual approval")
                                        </MudText>
                                    </div>
                                </MudStack>
                                <MudSwitch T="bool"
                                           Value="_user.AutoAcceptBookings"
                                           ValueChanged="ToggleAutoAccept"
                                           Color="Color.Success"
                                           Disabled="_isTogglingAutoAccept" />
                            </MudStack>
                        </MudPaper>

                        <MudDivider />

                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Working Hours</MudText>

                        @if (!_isEditingWorkingHours)
                        {
                            @if (!_hasCustomHours)
                            {
                                @* No custom hours — using org defaults *@
                                <MudPaper Elevation="0" Class="pa-3 pa-sm-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px;">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Using organization default hours
                                            </MudText>
                                        </MudStack>

                                        @if (_orgHoursLoaded)
                                        {
                                            @foreach (var day in _daysOfWeek)
                                            {
                                                var schedule = _orgOperatingHours.GetValueOrDefault(day);
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                                           Style="min-height: 36px;">
                                                    <MudText Typo="Typo.caption" Style="font-weight: 600; min-width: 80px;">
                                                        @day.ToString()[..3]
                                                    </MudText>
                                                    @if (schedule is { IsOpen: true })
                                                    {
                                                        <MudText Typo="Typo.caption">
                                                            @FormatTime(schedule.OpenTime) &ndash; @FormatTime(schedule.CloseTime)
                                                        </MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Closed</MudText>
                                                    }
                                                </MudStack>
                                            }
                                        }

                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Schedule"
                                                   OnClick="StartEditingWorkingHours"
                                                   Style="min-height: 44px;" FullWidth="true">
                                            Customize Hours
                                        </MudButton>
                                    </MudStack>
                                </MudPaper>
                            }
                            else
                            {
                                @* Custom hours set *@
                                <MudPaper Elevation="0" Class="pa-3 pa-sm-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px;">
                                    <MudStack Spacing="2">
                                        @foreach (var day in _daysOfWeek)
                                        {
                                            var schedule = _providerWorkingHours!.GetValueOrDefault(day);
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                                       Style="min-height: 36px;">
                                                <MudText Typo="Typo.body2" Style="font-weight: 600; min-width: 100px;">
                                                    @day.ToString()
                                                </MudText>
                                                @if (schedule is { IsOpen: true })
                                                {
                                                    <MudText Typo="Typo.body2">
                                                        @FormatTime(schedule.OpenTime) &ndash; @FormatTime(schedule.CloseTime)
                                                    </MudText>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Off</MudText>
                                                }
                                            </MudStack>
                                            @if (day != DayOfWeek.Sunday)
                                            {
                                                <MudDivider />
                                            }
                                        }

                                        <MudStack Row="true" Spacing="2" Class="mt-1">
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.Edit"
                                                       OnClick="StartEditingWorkingHours"
                                                       Style="min-height: 44px;">
                                                Edit Hours
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" Color="Color.Secondary"
                                                       StartIcon="@Icons.Material.Filled.RestartAlt"
                                                       OnClick="ResetWorkingHours"
                                                       Disabled="_isSavingWorkingHours"
                                                       Style="min-height: 44px;">
                                                Reset to Default
                                            </MudButton>
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        }
                        else
                        {
                            @* Edit mode for working hours *@
                            <MudPaper Elevation="0" Class="pa-3 pa-sm-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 12px;">
                                <MudStack Spacing="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Set your availability within organization hours. Days the organization is closed cannot be enabled.
                                    </MudText>

                                    @foreach (var day in _daysOfWeek)
                                    {
                                        var orgSchedule = _orgOperatingHours.GetValueOrDefault(day);
                                        var orgClosed = orgSchedule is null or { IsOpen: false };

                                        <div>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                                <MudText Typo="Typo.body2" Style="font-weight: 600; min-width: 100px;">
                                                    @day.ToString()
                                                </MudText>
                                                @if (orgClosed)
                                                {
                                                    <MudSwitch T="bool" Value="false" Disabled="true" Color="Color.Primary" />
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Organization closed</MudText>
                                                }
                                                else
                                                {
                                                    <MudSwitch T="bool" Value="_editWorkingHours[day].IsOpen"
                                                               ValueChanged="@(v => ToggleWorkingDay(day, v, orgSchedule!))"
                                                               Color="Color.Primary" />
                                                    <MudText Typo="Typo.body2" Color="@(_editWorkingHours[day].IsOpen ? Color.Success : Color.Secondary)">
                                                        @(_editWorkingHours[day].IsOpen ? "Working" : "Off")
                                                    </MudText>
                                                }
                                            </MudStack>

                                            @if (!orgClosed && _editWorkingHours[day].IsOpen)
                                            {
                                                <MudGrid Spacing="2" Class="mt-2 ml-sm-13">
                                                    <MudItem xs="12" sm="6">
                                                        <MudTimePicker @bind-Time="_editWorkingHours[day].OpenTimeSpan"
                                                                       Label="Start"
                                                                       Variant="Variant.Outlined"
                                                                       AmPm="true"
                                                                       HelperText="@($"Org: {FormatTime(orgSchedule!.OpenTime)}")" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6">
                                                        <MudTimePicker @bind-Time="_editWorkingHours[day].CloseTimeSpan"
                                                                       Label="End"
                                                                       Variant="Variant.Outlined"
                                                                       AmPm="true"
                                                                       HelperText="@($"Org: {FormatTime(orgSchedule!.CloseTime)}")" />
                                                    </MudItem>
                                                </MudGrid>
                                            }
                                        </div>
                                        @if (day != DayOfWeek.Sunday)
                                        {
                                            <MudDivider />
                                        }
                                    }

                                    @* Desktop: right-aligned row *@
                                    <MudHidden Breakpoint="Breakpoint.Xs">
                                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                            <MudButton Variant="Variant.Text" OnClick="CancelEditingWorkingHours">Cancel</MudButton>
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                       OnClick="SaveWorkingHours"
                                                       Disabled="_isSavingWorkingHours">
                                                @if (_isSavingWorkingHours)
                                                {
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                    <text>Saving...</text>
                                                }
                                                else
                                                {
                                                    <text>Save Hours</text>
                                                }
                                            </MudButton>
                                        </MudStack>
                                    </MudHidden>
                                    @* Mobile: full-width stacked *@
                                    <MudHidden Breakpoint="Breakpoint.SmAndUp">
                                        <MudStack Spacing="2">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                                       OnClick="SaveWorkingHours" Disabled="_isSavingWorkingHours"
                                                       Style="min-height: 48px;">
                                                @if (_isSavingWorkingHours)
                                                {
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                    <text>Saving...</text>
                                                }
                                                else
                                                {
                                                    <text>Save Hours</text>
                                                }
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" OnClick="CancelEditingWorkingHours" FullWidth="true"
                                                       Style="min-height: 48px;">
                                                Cancel
                                            </MudButton>
                                        </MudStack>
                                    </MudHidden>
                                </MudStack>
                            </MudPaper>
                        }
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="StartEditing"
                               Style="min-height: 44px;">
                        Edit Profile
                    </MudButton>
                }
                else
                {
                    @* Edit mode *@
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editFirstName"
                                          Label="First Name"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_editLastName"
                                          Label="Last Name"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>
                    </MudGrid>

                    <MudTextField @bind-Value="_editPhone"
                                  Label="Phone Number"
                                  Variant="Variant.Outlined"
                                  Placeholder="+63..." />

                    @* Desktop: right-aligned row *@
                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                            <MudButton Variant="Variant.Text" OnClick="CancelEditing">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="SaveProfile"
                                       Disabled="_isSaving">
                                @if (_isSaving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <text>Saving...</text>
                                }
                                else
                                {
                                    <text>Save Changes</text>
                                }
                            </MudButton>
                        </MudStack>
                    </MudHidden>
                    @* Mobile: full-width stacked *@
                    <MudHidden Breakpoint="Breakpoint.SmAndUp">
                        <MudStack Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                       OnClick="SaveProfile" Disabled="_isSaving"
                                       Size="Size.Medium" Style="min-height: 48px;">
                                @if (_isSaving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <text>Saving...</text>
                                }
                                else
                                {
                                    <text>Save Changes</text>
                                }
                            </MudButton>
                            <MudButton Variant="Variant.Text" OnClick="CancelEditing" FullWidth="true"
                                       Size="Size.Medium" Style="min-height: 48px;">
                                Cancel
                            </MudButton>
                        </MudStack>
                    </MudHidden>
                }
            </MudStack>
        }
    </div>
</MudPaper>
