@page "/"
@layout EmptyLayout

<PageTitle>Book me App! - Streamline Your Appointments & Bookings</PageTitle>

<HeadContent>
    <meta name="description" content="Transform your booking management with our powerful scheduling system. Perfect for salons, clinics, gyms, and service businesses in the Philippines. Start your 7-day free trial today!" />
    <meta name="keywords" content="booking system, appointment scheduling, booking management, scheduling software, salon booking, clinic appointment, Philippines" />
    <meta name="author" content="Book me App!" />
    <meta property="og:title" content="Book me App! - Streamline Your Appointments" />
    <meta property="og:description" content="Transform your booking management with our powerful scheduling system. 7-day free trial available!" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://bookmyapp.ph" />
</HeadContent>

@* Simple Navigation Header *@
<MudAppBar Elevation="1" Color="Color.Surface">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <img src="logo.png" alt="Book me App!" style="height: 40px; width: auto;" />
    </MudStack>
    <MudSpacer />

    @* Desktop Navigation *@
    <MudStack Row="true" Spacing="2" Class="d-none d-md-flex">
        <MudButton Href="#features" Variant="Variant.Text" Color="Color.Default">Features</MudButton>
        <MudButton Href="#pricing" Variant="Variant.Text" Color="Color.Default">Pricing</MudButton>
        <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary">
            Sign In
        </MudButton>
    </MudStack>

    @* Mobile Navigation *@
    <MudStack Row="true" Spacing="1" Class="d-flex d-md-none">
        <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
            Sign In
        </MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Default" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
    </MudStack>
</MudAppBar>

@* Mobile Menu Drawer *@
<MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Elevation="2" Variant="@DrawerVariant.Temporary">
    <MudDrawerHeader>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <img src="logo.png" alt="Book me App!" style="height: 40px; width: auto;" />
        </MudStack>
    </MudDrawerHeader>
    <MudNavMenu>
        <MudNavLink Href="#features" OnClick="@(() => _drawerOpen = false)">
            <MudText>Features</MudText>
        </MudNavLink>
        <MudNavLink Href="#pricing" OnClick="@(() => _drawerOpen = false)">
            <MudText>Pricing</MudText>
        </MudNavLink>
        <MudDivider Class="my-2" />
        <MudNavLink Href="/login">
            <MudText>Sign In</MudText>
        </MudNavLink>
        <MudNavLink Href="/register-organization">
            <MudText Color="Color.Primary" Style="font-weight: 600;">Start Free Trial</MudText>
        </MudNavLink>
    </MudNavMenu>
</MudDrawer>

@* Hero Section *@
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 py-md-8 px-4" Style="margin-top: 64px;">
    <MudGrid Spacing="4" Justify="Justify.Center">
        <MudItem xs="12" md="6" Class="d-flex align-center">
            <MudStack Spacing="3">
                <MudText Class="fw-bold" Style="font-size: clamp(1.75rem, 5vw, 2.5rem); line-height: 1.2;">
                    Simplify Your <span style="color: var(--mud-palette-primary);">Booking</span> Management
                </MudText>
                <MudText Style="font-size: clamp(1rem, 3vw, 1.25rem);" Color="Color.Secondary">
                    All-in-one scheduling solution for businesses in the Philippines
                </MudText>
                <MudText Typo="Typo.body1">
                    Say goodbye to double bookings and missed appointments. Our intuitive system helps you manage schedules,
                    track bookings, and delight your customers - all in one place.
                </MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Href="/register-organization"
                               StartIcon="@Icons.Material.Filled.Rocket"
                               Style="min-height: 48px;">
                        Start Free Trial
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Href="#pricing"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               Style="min-height: 48px;">
                        View Pricing
                    </MudButton>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    ✨ 7-day free trial • No credit card required • 2 bookings per day during trial
                </MudText>
            </MudStack>
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex align-center justify-center">
            <MudPaper Elevation="8" Class="pa-4 pa-md-8" Style="background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-secondary) 100%); border-radius: 24px; width: 100%;">
                <MudStack Spacing="3" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Style="font-size: clamp(80px, 15vw, 120px); color: white;" />
                    <MudText Style="color: white; text-align: center; font-size: clamp(1.25rem, 4vw, 1.75rem); font-weight: 600;">Smart Scheduling</MudText>
                    <MudText Typo="Typo.body1" Style="color: white; text-align: center;">
                        Built for Filipino businesses
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

