@page "/admin/users"
@page "/{Slug}/admin/users"
@rendermode InteractiveServer
@attribute [Authorize]
@attribute [Authorize(Roles = "GlobalAdmin")]
@using Microsoft.AspNetCore.Authorization
@using BookingScheduleSystem.Contracts.Users
@using BookingScheduleSystem.Contracts.Tenants
@using BookingScheduleSystem.Contracts.Common
@using BookingScheduleSystem.Web.Components.Admin
@inject IUserService UserService
@inject ITenantService TenantService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Manage Users</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudText Typo="Typo.h5" Class="mb-4">Manage Users</MudText>

    @* Filter Chips *@
    <MudStack Row="true" Spacing="2" Class="mb-4" AlignItems="AlignItems.Center" Style="flex-wrap: wrap;">
        <MudChip T="string"
                 Color="@(_activeFilter == null ? Color.Primary : Color.Default)"
                 Variant="@(_activeFilter == null ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => FilterByActive(null))">
            All
        </MudChip>
        <MudChip T="string"
                 Color="@(_activeFilter == true ? Color.Success : Color.Default)"
                 Variant="@(_activeFilter == true ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => FilterByActive(true))">
            Active
        </MudChip>
        <MudChip T="string"
                 Color="@(_activeFilter == false ? Color.Error : Color.Default)"
                 Variant="@(_activeFilter == false ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => FilterByActive(false))">
            Inactive
        </MudChip>
    </MudStack>

    @if (_loading)
    {
        <MudStack Spacing="2">
            @for (var i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="52px" />
            }
        </MudStack>
    }
    else if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
            @_errorMessage
        </MudAlert>
        <MudButton Variant="Variant.Outlined" OnClick="LoadUsersAsync"
                   StartIcon="@Icons.Material.Filled.Refresh">
            Retry
        </MudButton>
    }
    else
    {
        @* Desktop Table *@
        <MudHidden Breakpoint="Breakpoint.Xs">
            <MudTable Items="_users" Hover="true" Striped="true" Dense="true"
                      Loading="_loading" LoadingProgressColor="Color.Primary">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Phone</MudTh>
                    <MudTh>Tenant</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate Context="user">
                    <MudTd DataLabel="Name">@user.FirstName @user.LastName</MudTd>
                    <MudTd DataLabel="Email">@user.Email</MudTd>
                    <MudTd DataLabel="Phone">@(user.PhoneNumber ?? "—")</MudTd>
                    <MudTd DataLabel="Tenant">@GetTenantName(user.TenantId)</MudTd>
                    <MudTd DataLabel="Role">
                        @if (user.IsGlobalAdmin)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Admin</MudChip>
                        }
                        else if (user.IsProvider)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Provider</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">Customer</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(user.IsActive ? Color.Success : Color.Default)"
                                 Variant="Variant.Filled">
                            @(user.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                         OnClick="@(() => OpenEditDialog(user))">
                                Edit
                            </MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.LockReset"
                                         OnClick="@(() => OpenResetPasswordDialog(user))">
                                Reset Password
                            </MudMenuItem>
                            @if (user.IsActive)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Block"
                                             IconColor="Color.Warning"
                                             OnClick="@(() => HandleDeactivate(user))">
                                    Deactivate
                                </MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Filled.DeleteForever"
                                         IconColor="Color.Error"
                                         OnClick="@(() => HandleDelete(user))">
                                Delete
                            </MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body1" Align="Align.Center" Class="py-6">
                        No users found.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudHidden>

        @* Mobile Card List *@
        <MudHidden Breakpoint="Breakpoint.SmAndUp">
            <MudStack Spacing="2">
                @if (!_users.Any())
                {
                    <MudText Typo="Typo.body1" Align="Align.Center" Class="py-6">
                        No users found.
                    </MudText>
                }
                @foreach (var user in _users)
                {
                    <MudCard Elevation="1">
                        <MudCardContent>
                            <MudStack Spacing="1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                                        @user.FirstName @user.LastName
                                    </MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(user.IsActive ? Color.Success : Color.Default)"
                                             Variant="Variant.Filled">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </MudChip>
                                </MudStack>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@user.Email</MudText>
                                @if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@user.PhoneNumber</MudText>
                                }
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Tenant: @GetTenantName(user.TenantId)
                                    </MudText>
                                    @if (user.IsGlobalAdmin)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Admin</MudChip>
                                    }
                                    else if (user.IsProvider)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Provider</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">Customer</MudChip>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => OpenEditDialog(user))">
                                Edit
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Filled.LockReset"
                                       OnClick="@(() => OpenResetPasswordDialog(user))">
                                Reset Password
                            </MudButton>
                            @if (user.IsActive)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Block"
                                           OnClick="@(() => HandleDeactivate(user))">
                                    Deactivate
                                </MudButton>
                            }
                        </MudCardActions>
                    </MudCard>
                }
            </MudStack>
        </MudHidden>

        @* Pagination *@
        @if (_totalPages > 1)
        {
            <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
                <MudPagination Count="_totalPages"
                               Selected="_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               Variant="Variant.Outlined"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </MudStack>
        }
    }
</MudContainer>

@code {
    [Parameter] public string? Slug { get; set; }

    private List<UserResponse> _users = new();
    private Dictionary<Guid, string> _tenantNames = new();
    private bool? _activeFilter;
    private bool _loading = true;
    private string? _errorMessage;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int PageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        var usersTask = LoadUsersAsync();
        var tenantsTask = LoadTenantsAsync();
        await Task.WhenAll(usersTask, tenantsTask);
    }

    private async Task LoadUsersAsync()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await UserService.ListUsersAsync(
                isProvider: null, isActive: _activeFilter,
                page: _currentPage, pageSize: PageSize);

            if (result is not null)
            {
                _users = result.Users;
                _totalPages = result.TotalCount > 0
                    ? (int)Math.Ceiling((double)result.TotalCount / PageSize)
                    : 1;
            }
            else
            {
                _users = new();
                _totalPages = 1;
            }
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = ex.Message;
            _users = new();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            var tenants = await TenantService.ListTenantsAsync();
            if (tenants is not null)
            {
                _tenantNames = tenants.ToDictionary(t => t.Id.Value, t => $"{t.Name} ({t.Subdomain})");
            }
        }
        catch
        {
            _tenantNames = new();
        }
    }

    private string GetTenantName(TenantId? tenantId)
    {
        if (tenantId is null) return "— No Tenant —";
        var id = tenantId.Value.Value;
        return _tenantNames.TryGetValue(id, out var name) ? name : id.ToString()[..8] + "...";
    }

    private async Task FilterByActive(bool? active)
    {
        _activeFilter = active;
        _currentPage = 1;
        await LoadUsersAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadUsersAsync();
    }

    private async Task OpenEditDialog(UserResponse user)
    {
        var parameters = new DialogParameters<AdminEditUserDialog>
        {
            { x => x.User, user }
        };

        var dialog = await DialogService.ShowAsync<AdminEditUserDialog>(
            $"Edit {user.FirstName} {user.LastName}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadUsersAsync();
        }
    }

    private async Task OpenResetPasswordDialog(UserResponse user)
    {
        var parameters = new DialogParameters<ResetPasswordDialog>
        {
            { x => x.CustomerName, $"{user.FirstName} {user.LastName}" },
            { x => x.UserId, user.Id.Value }
        };

        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>(
            "Reset Password",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        await dialog.Result;
    }

    private async Task HandleDeactivate(UserResponse user)
    {
        var parameters = new DialogParameters<DeleteConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to deactivate {user.FirstName} {user.LastName}? They will no longer be able to sign in." }
        };

        var dialog = await DialogService.ShowAsync<DeleteConfirmDialog>("Deactivate User", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        try
        {
            await UserService.DeactivateUserAsync(user.Id.Value);
            Snackbar.Add($"{user.FirstName} {user.LastName} has been deactivated", Severity.Success);
            await LoadUsersAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task HandleDelete(UserResponse user)
    {
        var parameters = new DialogParameters<DeleteConfirmDialog>
        {
            { x => x.ContentText, $"Are you sure you want to permanently delete {user.FirstName} {user.LastName}? This action cannot be undone." }
        };

        var dialog = await DialogService.ShowAsync<DeleteConfirmDialog>("Delete User", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        try
        {
            await UserService.DeleteUserAsync(user.Id.Value);
            Snackbar.Add($"{user.FirstName} {user.LastName} has been deleted", Severity.Success);
            await LoadUsersAsync();
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
