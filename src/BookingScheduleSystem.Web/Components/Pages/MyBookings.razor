@page "/my-bookings"
@page "/{Slug}/my-bookings"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject IBookingService BookingService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<AuthorizeView>
    <Authorized>
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px; overflow: hidden;">
            @* Header bar *@
            <div class="d-flex align-center pa-4 px-5" style="border-bottom: 1px solid var(--mud-palette-divider);">
                <div class="mr-auto">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">My Bookings</MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">Manage your appointments</MudText>
                </div>
            </div>

            <div class="pa-5">
                <MudStack Spacing="3">
                    @* Status Filter *@
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudChip T="string" Color="@(_statusFilter == null ? Color.Primary : Color.Default)"
                                 Variant="@(_statusFilter == null ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => FilterByStatus(null))">All</MudChip>
                        <MudChip T="string" Color="@(_statusFilter == BookingStatus.Pending ? Color.Warning : Color.Default)"
                                 Variant="@(_statusFilter == BookingStatus.Pending ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => FilterByStatus(BookingStatus.Pending))">Pending</MudChip>
                        <MudChip T="string" Color="@(_statusFilter == BookingStatus.Confirmed ? Color.Success : Color.Default)"
                                 Variant="@(_statusFilter == BookingStatus.Confirmed ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => FilterByStatus(BookingStatus.Confirmed))">Confirmed</MudChip>
                        <MudChip T="string" Color="@(_statusFilter == BookingStatus.Cancelled ? Color.Error : Color.Default)"
                                 Variant="@(_statusFilter == BookingStatus.Cancelled ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => FilterByStatus(BookingStatus.Cancelled))">Cancelled</MudChip>
                    </MudStack>

                    @if (_isLoading)
                    {
                        <MudStack Spacing="2">
                            @for (var i = 0; i < 3; i++)
                            {
                                <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px;">
                                    <MudStack Spacing="2">
                                        <MudSkeleton Width="60%" Height="20px" />
                                        <MudSkeleton Width="80%" Height="16px" />
                                        <MudSkeleton Width="40%" Height="16px" />
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    else if (_bookings == null || _bookings.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">
                            No bookings found. <MudLink Href="/browse-schedules">Browse available schedules</MudLink> to make a booking.
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var booking in _bookings)
                            {
                                <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px;">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.body1" Style="font-weight: 700;">
                                                @(booking.ScheduleTitle ?? "Schedule")
                                            </MudText>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@GetStatusColor(booking.Status)"
                                                     Variant="Variant.Filled">
                                                @booking.Status
                                            </MudChip>
                                        </MudStack>

                                        @if (booking.ScheduleStartTime.HasValue)
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.body2">
                                                    @booking.ScheduleStartTime.Value.ToString("ddd, MMM dd, yyyy")
                                                </MudText>
                                            </MudStack>
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                    @booking.ScheduleStartTime.Value.ToString("h:mm tt") - @(booking.ScheduleEndTime?.ToString("h:mm tt") ?? "")
                                                </MudText>
                                            </MudStack>
                                        }

                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" Color="Color.Secondary" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Booked on @booking.BookedAt.ToString("MMM dd, yyyy")
                                            </MudText>
                                        </MudStack>

                                        @* Notes display / inline editing *@
                                        @if (_editingNotesBookingId == booking.Id)
                                        {
                                            <MudTextField T="string" @bind-Value="_editNotesText"
                                                          Label="Notes" Variant="Variant.Outlined" Lines="3"
                                                          Placeholder="Add any notes or special requests..." />
                                            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                                           OnClick="CancelEditNotes">Cancel</MudButton>
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                           OnClick="@(() => SaveNotes(booking))"
                                                           Disabled="@_isSavingNotes"
                                                           StartIcon="@Icons.Material.Filled.Check">
                                                    @(_isSavingNotes ? "Saving..." : "Save")
                                                </MudButton>
                                            </MudStack>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(booking.Notes))
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Color="Color.Secondary" Class="mt-1" />
                                                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary); white-space: pre-line;">
                                                    @booking.Notes
                                                </MudText>
                                                @if (booking.Status != BookingStatus.Cancelled)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                                   OnClick="@(() => StartEditNotes(booking))" />
                                                }
                                            </MudStack>
                                        }
                                        else if (booking.Status != BookingStatus.Cancelled)
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.NoteAdd"
                                                       OnClick="@(() => StartEditNotes(booking))">
                                                Add Notes
                                            </MudButton>
                                        }

                                        @if (booking.Status != BookingStatus.Cancelled)
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                                       OnClick="@(() => CancelBooking(booking))"
                                                       Disabled="@_isCancelling"
                                                       StartIcon="@Icons.Material.Filled.Cancel">
                                                Cancel Booking
                                            </MudButton>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>

                        @if (_totalCount > _pageSize)
                        {
                            <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                                <MudPagination Count="@((int)Math.Ceiling((double)_totalCount / _pageSize))"
                                               Selected="@_currentPage"
                                               SelectedChanged="OnPageChanged"
                                               Color="Color.Primary" />
                            </MudStack>
                        }
                    }
                </MudStack>
            </div>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">
            Please <MudLink Href="/login">sign in</MudLink> to view your bookings.
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public string? Slug { get; set; }

    private List<BookingResponse>? _bookings;
    private bool _isLoading = true;
    private bool _isCancelling;
    private bool _isSavingNotes;
    private BookingStatus? _statusFilter;
    private int _currentPage = 1;
    private int _pageSize = 20;
    private int _totalCount;
    private BookingId? _editingNotesBookingId;
    private string? _editNotesText;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await BookingService.ListBookingsAsync(_statusFilter, _currentPage, _pageSize);
            if (result != null)
            {
                _bookings = result.Bookings;
                _totalCount = result.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task FilterByStatus(BookingStatus? status)
    {
        _statusFilter = status;
        _currentPage = 1;
        await LoadBookings();
    }

    private async Task CancelBooking(BookingResponse booking)
    {
        _isCancelling = true;
        StateHasChanged();

        try
        {
            var result = await BookingService.CancelBookingAsync(booking.Id.Value);
            if (result != null)
            {
                Snackbar.Add("Booking cancelled successfully.", Severity.Success);
                await LoadBookings();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadBookings();
    }

    private void StartEditNotes(BookingResponse booking)
    {
        _editingNotesBookingId = booking.Id;
        _editNotesText = booking.Notes;
    }

    private void CancelEditNotes()
    {
        _editingNotesBookingId = null;
        _editNotesText = null;
    }

    private async Task SaveNotes(BookingResponse booking)
    {
        _isSavingNotes = true;
        StateHasChanged();

        try
        {
            var notes = string.IsNullOrWhiteSpace(_editNotesText) ? null : _editNotesText.Trim();
            var result = await BookingService.UpdateBookingNotesAsync(booking.Id.Value, notes);
            if (result != null)
            {
                Snackbar.Add("Notes updated.", Severity.Success);
                _editingNotesBookingId = null;
                _editNotesText = null;
                await LoadBookings();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSavingNotes = false;
        }
    }

    private Color GetStatusColor(BookingStatus status) => status switch
    {
        BookingStatus.Pending => Color.Warning,
        BookingStatus.Confirmed => Color.Success,
        BookingStatus.Cancelled => Color.Error,
        BookingStatus.Completed => Color.Info,
        _ => Color.Default
    };
}
