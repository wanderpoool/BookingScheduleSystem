@page "/{Slug}"
@layout EmptyLayout
@rendermode InteractiveServer
@using BookingScheduleSystem.Contracts.Tenants
@using System.Text.Json
@inject ITenantService TenantService
@inject IScheduleService ScheduleService
@inject NavigationManager Navigation

<PageTitle>@(_tenant?.Name ?? "Loading...") — Book an Appointment</PageTitle>

<MudThemeProvider @ref="_themeProvider" IsDarkMode="@_isDarkMode" Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_isLoading)
{
    <div class="provider-landing">
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-16">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="72px" Height="72px" />
                <MudSkeleton Width="200px" Height="32px" />
                <MudSkeleton Width="140px" Height="20px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="120px" Style="border-radius: 14px;" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="48px" Style="border-radius: 14px;" />
            </MudStack>
        </MudContainer>
    </div>
}
else if (_tenant == null)
{
    <div class="provider-landing">
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-16">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 700;">Page Not Found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    This business page doesn't exist or is no longer active.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Href="/" Style="min-height: 44px; margin-top: 16px;">
                    Go Home
                </MudButton>
            </MudStack>
        </MudContainer>
    </div>
}
else
{
    var template = _tenant.LandingPageTemplate ?? "simple";

    @if (template == "premium")
    {
        @* ====== PREMIUM TEMPLATE ====== *@
        <div class="provider-landing premium-template">
            @* Hero Banner *@
            <div class="premium-hero" style="@GetHeroBackground()">
                <div class="premium-hero-overlay"></div>
                <div class="premium-hero-content">
                    <MudText Typo="Typo.h5" Align="Align.Center"
                             Style="font-weight: 800; color: white; position: relative; z-index: 1;">
                        @_tenant.Name
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(_tenant.Description))
                    {
                        <MudText Typo="Typo.body1" Align="Align.Center"
                                 Style="color: rgba(255,255,255,0.85); max-width: 500px; margin: 8px auto 0; position: relative; z-index: 1;">
                            @_tenant.Description
                        </MudText>
                    }
                </div>
            </div>

            <MudContainer MaxWidth="MaxWidth.Small" Class="premium-body">
                @* Services / Description Section *@
                @if (!string.IsNullOrWhiteSpace(_tenant.Description))
                {
                    <MudPaper Elevation="0" Class="landing-card">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">About</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_tenant.Description</MudText>
                    </MudPaper>
                }

                @* Operating Hours Card *@
                @if (_operatingHoursList.Count > 0)
                {
                    <MudPaper Elevation="0" Class="landing-card">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Operating Hours</MudText>
                        </MudStack>
                        <MudStack Spacing="1">
                            @foreach (var hours in _operatingHoursList)
                            {
                                <div class="hours-row">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600; min-width: 100px;">@hours.Day</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@hours.Time</MudText>
                                </div>
                            }
                        </MudStack>
                    </MudPaper>
                }

                @* Location Card *@
                @if (!string.IsNullOrWhiteSpace(_tenant.Location))
                {
                    <MudPaper Elevation="0" Class="landing-card">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@_tenant.Location</MudText>
                        </MudStack>
                    </MudPaper>
                }

                @* CTA Buttons *@
                <div class="landing-cta-area">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Chat"
                               OnClick="OpenChatbot"
                               Style="min-height: 52px; font-size: 16px; font-weight: 600;">
                        Chat to Book
                    </MudButton>
                    <MudStack Row="true" Justify="Justify.Center" Spacing="3" Class="mt-3">
                        <MudLink Href="@($"/{Slug}/login")" Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 500;">
                            Sign In
                        </MudLink>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">|</MudText>
                        <MudLink Href="@($"/{Slug}/register")" Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 500;">
                            Create Account
                        </MudLink>
                    </MudStack>
                </div>

                @* Dark mode toggle *@
                <div class="d-flex justify-center mt-2 mb-4">
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                   Color="Color.Secondary" Size="Size.Medium"
                                   OnClick="ToggleDarkMode" />
                </div>

                @* Powered by footer *@
                @if (ShowPoweredBy())
                {
                    <div class="powered-by-footer">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
                            Powered by <MudLink Href="/" Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">BookMeApp</MudLink>
                        </MudText>
                    </div>
                }
            </MudContainer>

            <ChatbotWidget TenantId="@_tenant.Id.Value" TenantSlug="@Slug" TenantName="@_tenant.Name" @ref="_chatbotWidget" />
        </div>
    }
    else
    {
        @* ====== SIMPLE TEMPLATE (Default) ====== *@
        <div class="provider-landing simple-template">
            <MudContainer MaxWidth="MaxWidth.Small" Class="simple-body">
                @* Avatar / Logo placeholder *@
                <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                    <MudAvatar Size="Size.Large"
                               Style="width: 72px; height: 72px; font-size: 28px; font-weight: 700;"
                               Color="Color.Primary">
                        @GetInitials()
                    </MudAvatar>

                    <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 800;">
                        @_tenant.Name
                    </MudText>

                    @if (!string.IsNullOrWhiteSpace(_tenant.Location))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                 Icon="@Icons.Material.Filled.LocationOn">
                            @_tenant.Location
                        </MudChip>
                    }
                </MudStack>

                @* Description *@
                @if (!string.IsNullOrWhiteSpace(_tenant.Description))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4"
                             Style="max-width: 400px; margin-left: auto; margin-right: auto;">
                        @_tenant.Description
                    </MudText>
                }

                @* Operating Hours *@
                @if (_operatingHoursList.Count > 0)
                {
                    <MudPaper Elevation="0" Class="landing-card">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Hours</MudText>
                        </MudStack>
                        <MudStack Spacing="1">
                            @foreach (var hours in _operatingHoursList)
                            {
                                <div class="hours-row">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600; min-width: 100px;">@hours.Day</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@hours.Time</MudText>
                                </div>
                            }
                        </MudStack>
                    </MudPaper>
                }

                @* CTA *@
                <div class="landing-cta-area">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.CalendarMonth"
                               OnClick="OpenChatbot"
                               Style="min-height: 52px; font-size: 16px; font-weight: 600;">
                        Book an Appointment
                    </MudButton>
                    <MudStack Row="true" Justify="Justify.Center" Spacing="3" Class="mt-3">
                        <MudLink Href="@($"/{Slug}/login")" Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 500;">
                            Sign In
                        </MudLink>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">|</MudText>
                        <MudLink Href="@($"/{Slug}/register")" Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 500;">
                            Create Account
                        </MudLink>
                    </MudStack>
                </div>

                @* Dark mode toggle *@
                <div class="d-flex justify-center mt-2 mb-4">
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                   Color="Color.Secondary" Size="Size.Medium"
                                   OnClick="ToggleDarkMode" />
                </div>

                @* Powered by footer *@
                @if (ShowPoweredBy())
                {
                    <div class="powered-by-footer">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
                            Powered by <MudLink Href="/" Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">BookMeApp</MudLink>
                        </MudText>
                    </div>
                }
            </MudContainer>

            <ChatbotWidget TenantId="@_tenant.Id.Value" TenantSlug="@Slug" TenantName="@_tenant.Name" @ref="_chatbotWidget" />
        </div>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private TenantResponse? _tenant;
    private bool _isLoading = true;
    private bool _isDarkMode;
    private MudThemeProvider? _themeProvider;
    private ChatbotWidget? _chatbotWidget;
    private List<OperatingHoursEntry> _operatingHoursList = new();

    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#E85D2A",
            PrimaryContrastText = "#FFFFFF",
            PrimaryDarken = "#C94A1D",
            PrimaryLighten = "#F28B5F",
            Secondary = "#1B2D45",
            SecondaryContrastText = "#FFFFFF",
            Tertiary = "#FFC53D",
            Success = "#10B981",
            Info = "#3B82F6",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#FFF8F0",
            Surface = "#FFFFFF",
            TextPrimary = "#1B2D45",
            TextSecondary = "#5A6B80",
            TextDisabled = "#9CA3AF",
            Divider = "#E8DFD5",
            DividerLight = "#F5EDE4",
            ActionDefault = "#5A6B80",
            HoverOpacity = 0.04,
            RippleOpacity = 0.08
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#F28B5F",
            PrimaryContrastText = "#1A1612",
            PrimaryDarken = "#E85D2A",
            PrimaryLighten = "#F5A880",
            Secondary = "#8BA4C4",
            SecondaryContrastText = "#1A1612",
            Tertiary = "#FFD97A",
            Success = "#34D399",
            Info = "#60A5FA",
            Warning = "#FBBF24",
            Error = "#F87171",
            Background = "#1A1612",
            Surface = "#262018",
            TextPrimary = "#F9F5F0",
            TextSecondary = "#A89B8C",
            TextDisabled = "#6B6050",
            Divider = "#3D3328",
            DividerLight = "#332B20",
            ActionDefault = "#A89B8C",
            HoverOpacity = 0.12,
            RippleOpacity = 0.2
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "14px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tenant = await TenantService.GetTenantBySubdomainAsync(Slug);
            if (_tenant != null)
            {
                ParseOperatingHours();
            }
        }
        catch
        {
            _tenant = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ParseOperatingHours()
    {
        if (string.IsNullOrWhiteSpace(_tenant?.OperatingHours))
            return;

        try
        {
            var hoursDict = JsonSerializer.Deserialize<Dictionary<string, string>>(_tenant.OperatingHours);
            if (hoursDict == null) return;

            var dayOrder = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
            foreach (var day in dayOrder)
            {
                if (hoursDict.TryGetValue(day, out var time) && !string.IsNullOrWhiteSpace(time))
                {
                    _operatingHoursList.Add(new OperatingHoursEntry(day, time));
                }
            }
        }
        catch
        {
            // Silently fail — hours just won't show
        }
    }

    private string GetHeroBackground()
    {
        if (!string.IsNullOrWhiteSpace(_tenant?.BannerUrl))
            return $"background-image: url('{_tenant.BannerUrl}');";

        return "background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-primary-darken) 100%);";
    }

    private string GetInitials()
    {
        if (_tenant == null) return "?";
        var parts = _tenant.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : _tenant.Name[..Math.Min(2, _tenant.Name.Length)].ToUpperInvariant();
    }

    private bool ShowPoweredBy()
    {
        // Show for free/trial tenants
        return _tenant?.IsInTrial == true || !(_tenant?.IsActive == true);
    }

    private void OpenChatbot()
    {
        _chatbotWidget?.Open();
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    private sealed record OperatingHoursEntry(string Day, string Time);
}
