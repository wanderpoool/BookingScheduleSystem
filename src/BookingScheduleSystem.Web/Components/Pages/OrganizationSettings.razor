@page "/organization"
@page "/{Slug}/organization"
@rendermode InteractiveServer
@attribute [Authorize]

<AuthorizeView Roles="Provider,GlobalAdmin">
    <Authorized>
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px; overflow: hidden;">
            <div class="d-flex align-center pa-4 px-5" style="border-bottom: 1px solid var(--mud-palette-divider);">
                <div class="mr-auto">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Organization Settings</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Manage your organization details</MudText>
                </div>
            </div>

            <div class="pa-5">
                @if (_isLoading)
                {
                    <MudStack Spacing="3">
                        <MudSkeleton Width="50%" Height="20px" />
                        <MudSkeleton Width="70%" Height="16px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius: 14px;" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius: 14px;" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius: 14px;" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius: 14px;" />
                    </MudStack>
                }
                else if (_tenant == null)
                {
                    <MudAlert Severity="Severity.Warning">Organization not found.</MudAlert>
                }
                else
                {
                    <MudStack Spacing="3">
                        @if (!_isEditing)
                        {
                            @* View mode *@
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Primary" />
                                    <MudText Typo="Typo.body1" Style="font-weight: 700;">@_tenant.Name</MudText>
                                </MudStack>

                                @if (!string.IsNullOrWhiteSpace(_tenant.Description))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_tenant.Description</MudText>
                                }

                                @if (!string.IsNullOrWhiteSpace(_tenant.Location))
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_tenant.Location</MudText>
                                    </MudStack>
                                }

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_tenant.Subdomain</MudText>
                                </MudStack>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Web" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Landing page: @((_tenant.LandingPageTemplate ?? "simple") == "premium" ? "Premium" : "Simple")
                                    </MudText>
                                </MudStack>

                                <MudStack Row="true" Spacing="2">
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(_tenant.IsActive ? Color.Success : Color.Error)"
                                             Variant="Variant.Filled">
                                        @(_tenant.IsActive ? "Active" : "Inactive")
                                    </MudChip>
                                    @if (_tenant.IsInTrial)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                            Trial ends @(_tenant.TrialEndDate?.ToString("MMM dd") ?? "soon")
                                        </MudChip>
                                    }
                                </MudStack>

                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Created @_tenant.CreatedAt.ToString("MMMM dd, yyyy")
                                </MudText>
                            </MudStack>

                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="StartEditing">
                                Edit Settings
                            </MudButton>
                        }
                        else
                        {
                            @* Edit mode *@
                            <MudTextField @bind-Value="_editName"
                                          Label="Organization Name"
                                          Variant="Variant.Outlined"
                                          Required="true" />

                            <MudTextField @bind-Value="_editDescription"
                                          Label="Description"
                                          Variant="Variant.Outlined"
                                          Lines="3" />

                            <MudTextField @bind-Value="_editLocation"
                                          Label="Location"
                                          Variant="Variant.Outlined"
                                          Placeholder="e.g., Manila, Philippines" />

                            <MudSelect @bind-Value="_editLandingPageTemplate"
                                       Label="Landing Page Template"
                                       Variant="Variant.Outlined"
                                       HelperText="Choose how your public booking page looks">
                                <MudSelectItem Value="@("simple")">Simple — Clean & Minimal</MudSelectItem>
                                <MudSelectItem Value="@("premium")">Premium — Rich Marketing Page</MudSelectItem>
                            </MudSelect>

                            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                <MudButton Variant="Variant.Text" OnClick="CancelEditing">Cancel</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveChanges"
                                           Disabled="_isSaving">
                                    @if (_isSaving)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <text>Saving...</text>
                                    }
                                    else
                                    {
                                        <text>Save Changes</text>
                                    }
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                }
            </div>
        </MudPaper>
        @if (_tenant != null && !_isLoading)
        {
            <MudPaper Elevation="0" Class="mt-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px; overflow: hidden;">
                <div class="d-flex align-center pa-4 px-5" style="border-bottom: 1px solid var(--mud-palette-divider);">
                    <div class="mr-auto">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Operating Hours</MudText>
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Set when your business is open for bookings</MudText>
                    </div>
                </div>

                <div class="pa-5">
                    @if (!_isEditingHours)
                    {
                        @* View mode *@
                        <MudStack Spacing="2">
                            @foreach (var day in _daysOfWeek)
                            {
                                var schedule = _operatingHours.GetValueOrDefault(day);
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                                           Style="min-height: 40px;">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600; min-width: 100px;">
                                        @day.ToString()
                                    </MudText>
                                    @if (schedule is { IsOpen: true })
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Default">
                                            @FormatTime(schedule.OpenTime) &ndash; @FormatTime(schedule.CloseTime)
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Closed</MudText>
                                    }
                                </MudStack>
                                @if (day != DayOfWeek.Sunday)
                                {
                                    <MudDivider />
                                }
                            }

                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="StartEditingHours" Class="mt-2">
                                Edit Hours
                            </MudButton>
                        </MudStack>
                    }
                    else
                    {
                        @* Edit mode *@
                        <MudStack Spacing="3">
                            @foreach (var day in _daysOfWeek)
                            {
                                <div>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                        <MudText Typo="Typo.body2" Style="font-weight: 600; min-width: 100px;">
                                            @day.ToString()
                                        </MudText>
                                        <MudSwitch T="bool" Value="_editHours[day].IsOpen"
                                                   ValueChanged="@(v => ToggleDay(day, v))"
                                                   Color="Color.Primary" />
                                        <MudText Typo="Typo.body2" Color="@(_editHours[day].IsOpen ? Color.Success : Color.Secondary)">
                                            @(_editHours[day].IsOpen ? "Open" : "Closed")
                                        </MudText>
                                    </MudStack>

                                    @if (_editHours[day].IsOpen)
                                    {
                                        <MudGrid Spacing="2" Class="mt-2 ml-sm-13">
                                            <MudItem xs="12" sm="6">
                                                <MudTimePicker @bind-Time="_editHours[day].OpenTimeSpan"
                                                               Label="Opens"
                                                               Variant="Variant.Outlined"
                                                               AmPm="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTimePicker @bind-Time="_editHours[day].CloseTimeSpan"
                                                               Label="Closes"
                                                               Variant="Variant.Outlined"
                                                               AmPm="true" />
                                            </MudItem>
                                        </MudGrid>
                                    }
                                </div>
                                @if (day != DayOfWeek.Sunday)
                                {
                                    <MudDivider />
                                }
                            }

                            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-2">
                                <MudButton Variant="Variant.Text" OnClick="CancelEditingHours">Cancel</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveOperatingHours"
                                           Disabled="_isSavingHours">
                                    @if (_isSavingHours)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <text>Saving...</text>
                                    }
                                    else
                                    {
                                        <text>Save Hours</text>
                                    }
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    }
                </div>
            </MudPaper>
        }
        @if (_tenant != null && !_isLoading && (_tenant.QueueEnabled || _isGlobalAdmin))
        {
            <MudPaper Elevation="0" Class="mt-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px; overflow: hidden;">
                <div class="d-flex align-center pa-4 px-5" style="border-bottom: 1px solid var(--mud-palette-divider);">
                    <div class="mr-auto">
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Queue Management</MudText>
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Configure virtual queue settings for walk-in customers</MudText>
                    </div>
                </div>

                <div class="pa-5">
                    @if (!_isEditingQueue)
                    {
                        @* View mode *@
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.body1" Style="font-weight: 600;">Queue</MudText>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(_tenant.QueueEnabled ? Color.Success : Color.Default)"
                                         Variant="Variant.Filled">
                                    @(_tenant.QueueEnabled ? "Enabled" : "Disabled")
                                </MudChip>
                            </MudStack>

                            @if (_tenant.QueueEnabled)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Average service time: @_tenant.QueueAverageServiceTimeMinutes min
                                    </MudText>
                                </MudStack>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        SMS notification: @_tenant.QueueNotificationLeadMinutes min before turn
                                    </MudText>
                                </MudStack>
                            }

                            @if (_tenant.QueueEnabled || _isGlobalAdmin)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           OnClick="StartEditingQueue" Class="mt-2">
                                    Edit Queue Settings
                                </MudButton>
                            }
                        </MudStack>
                    }
                    else
                    {
                        @* Edit mode *@
                        <MudStack Spacing="3">
                            @if (_isGlobalAdmin)
                            {
                                <MudSwitch @bind-Value="_editQueueEnabled" Color="Color.Primary"
                                           Label="@(_editQueueEnabled ? "Queue Enabled" : "Queue Disabled")" />
                            }
                            else
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">Queue Status:</MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(_editQueueEnabled ? Color.Success : Color.Default)"
                                             Variant="Variant.Filled">
                                        @(_editQueueEnabled ? "Enabled" : "Disabled")
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Only a system administrator can enable or disable the queue.
                                    </MudText>
                                </MudStack>
                            }

                            @if (_editQueueEnabled)
                            {
                                <MudNumericField @bind-Value="_editAverageServiceTime"
                                                 Label="Average Service Time (minutes)"
                                                 Variant="Variant.Outlined"
                                                 Min="5" Max="120" Step="5"
                                                 HelperText="Used to estimate wait times for customers" />

                                <MudSelect @bind-Value="_editNotificationLeadMinutes"
                                           Label="SMS Notification Lead Time"
                                           Variant="Variant.Outlined"
                                           HelperText="How far in advance to notify customers via SMS">
                                    <MudSelectItem Value="15">15 minutes before</MudSelectItem>
                                    <MudSelectItem Value="30">30 minutes before</MudSelectItem>
                                </MudSelect>
                            }

                            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-2">
                                <MudButton Variant="Variant.Text" OnClick="CancelEditingQueue">Cancel</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="SaveQueueSettings"
                                           Disabled="_isSavingQueue">
                                    @if (_isSavingQueue)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <text>Saving...</text>
                                    }
                                    else
                                    {
                                        <text>Save Settings</text>
                                    }
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    }
                </div>
            </MudPaper>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">You need Provider or Admin access to view organization settings.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

