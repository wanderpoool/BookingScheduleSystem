@page "/schedules"
@page "/{Slug}/schedules"
@rendermode InteractiveServer
@attribute [Authorize]

<AuthorizeView Roles="Provider,GlobalAdmin">
    <Authorized>
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px; overflow: hidden;">
            @* Header bar *@
            <div class="d-flex align-center pa-4 px-5 flex-wrap gap-2" style="border-bottom: 1px solid var(--mud-palette-divider);">
                <div class="mr-auto">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Manage Schedules</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">Create, edit, and manage your schedule slots</MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Share"
                           OnClick="OpenShareDialog"
                           Size="Size.Small">
                    Share
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog"
                           Size="Size.Small">
                    New Schedule
                </MudButton>
            </div>

            <div class="pa-5">
                <MudStack Spacing="3">
                    @* Filters *@
                    <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.Center">
                        <MudChip T="string" Color="@(_activeFilter == null ? Color.Primary : Color.Default)"
                                 Variant="@(_activeFilter == null ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => FilterByActive(null))">All</MudChip>
                        <MudChip T="string" Color="@(_activeFilter == true ? Color.Success : Color.Default)"
                                 Variant="@(_activeFilter == true ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => FilterByActive(true))">Active</MudChip>
                        <MudChip T="string" Color="@(_activeFilter == false ? Color.Error : Color.Default)"
                                 Variant="@(_activeFilter == false ? Variant.Filled : Variant.Outlined)"
                                 OnClick="@(() => FilterByActive(false))">Inactive</MudChip>

                        <MudSpacer />

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudIconButton Icon="@Icons.Material.Filled.ViewList"
                                           Color="@(_viewMode == ViewMode.List ? Color.Primary : Color.Default)"
                                           OnClick="@(() => SetViewMode(ViewMode.List))"
                                           Size="Size.Small" />
                            <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth"
                                           Color="@(_viewMode == ViewMode.Calendar ? Color.Primary : Color.Default)"
                                           OnClick="@(() => SetViewMode(ViewMode.Calendar))"
                                           Size="Size.Small" />
                        </MudStack>
                    </MudStack>

                    @if (_isLoading)
                    {
                        <MudStack Spacing="2">
                            @for (var i = 0; i < 3; i++)
                            {
                                <MudPaper Elevation="0" Class="pa-4" Style="border: 1px solid var(--mud-palette-divider); border-radius: 14px;">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                                            <MudSkeleton Width="50%" Height="20px" />
                                            <MudSkeleton Width="60px" Height="24px" Style="border-radius: 12px;" />
                                        </MudStack>
                                        <MudSkeleton Width="70%" Height="16px" />
                                        <MudSkeleton Width="40%" Height="16px" />
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    else if (_viewMode == ViewMode.Calendar)
                    {
                        @* Calendar View *@
                        <div style="position: relative;">
                            @if (_isCalendarLoading)
                            {
                                <div style="position: absolute; top: 0; left: 0; right: 0; z-index: 10;">
                                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                </div>
                            }

                            <BookMeCalendar Items="@_calendarItems"
                                            View="BookMeCalendarView.Week"
                                            MinVisibleTime="@(new TimeOnly(7, 0))"
                                            ItemClicked="@OnCalendarItemClicked"
                                            DateRangeChanged="@OnDateRangeChanged"
                                            Style="height: calc(100vh - 340px); min-height: 400px;">
                                <CellTemplate Context="calItem">
                                    <div style="width: 100%; height: 100%; border: 2px solid @(calItem.TimeBlock.IsAvailable ? "var(--mud-palette-success)" : "var(--mud-palette-error)"); background: @(calItem.TimeBlock.IsAvailable ? "var(--color-success-light)" : "var(--color-error-light)"); cursor: pointer; border-radius: 6px;">
                                        <div style="background: @(calItem.TimeBlock.IsAvailable ? "var(--mud-palette-success)" : "var(--mud-palette-error)"); padding: 2px 6px; border-radius: 4px 4px 0 0;">
                                            <span style="color: #fff; font-size: 12px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;">
                                                @calItem.Title
                                            </span>
                                        </div>
                                        <div style="padding: 4px 6px;">
                                            <span style="font-size: 12px; color: var(--color-text-secondary);">@calItem.Text</span>
                                        </div>
                                    </div>
                                </CellTemplate>
                            </BookMeCalendar>
                        </div>
                    }
                    else if (_schedules == null || _schedules.Count == 0)
                    {
                        @* Empty state *@
                        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" />
                            <MudText Typo="Typo.body1" Color="Color.Secondary">No schedules found</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Create your first schedule to start accepting bookings.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenCreateDialog">
                                Create Schedule
                            </MudButton>
                        </MudStack>
                    }
                    else
                    {
                        @* List View *@
                        <MudStack Spacing="2">
                            @foreach (var schedule in _schedules)
                            {
                                <MudPaper Elevation="0" Class="pa-4" Style="@($"border-top: 3px solid {(schedule.IsActive ? "var(--mud-palette-success)" : "var(--mud-palette-text-disabled)")}; border: 1px solid var(--mud-palette-divider); border-radius: 14px;")" @key="schedule.Id">
                                    <MudStack Spacing="2">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                            <div>
                                                <MudText Typo="Typo.body1" Style="font-weight: 700;">@schedule.Title</MudText>
                                                @if (!string.IsNullOrWhiteSpace(schedule.Description))
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@schedule.Description</MudText>
                                                }
                                            </div>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(schedule.IsActive ? Color.Success : Color.Default)"
                                                     Variant="Variant.Filled">
                                                @(schedule.IsActive ? "Active" : "Inactive")
                                            </MudChip>
                                        </MudStack>

                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                                            <MudText Typo="Typo.body2">@schedule.StartTime.ToString("ddd, MMM dd, yyyy")</MudText>
                                        </MudStack>

                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Secondary" />
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @schedule.StartTime.ToString("h:mm tt") - @schedule.EndTime.ToString("h:mm tt")
                                            </MudText>
                                        </MudStack>

                                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @schedule.CurrentBookings / @schedule.MaxCapacity booked
                                                </MudText>
                                            </MudStack>
                                            <MudProgressLinear Value="@GetBookingPercentage(schedule)"
                                                               Color="@(GetBookingPercentage(schedule) >= 100 ? Color.Error : Color.Primary)"
                                                               Rounded="true"
                                                               Size="Size.Small"
                                                               Style="max-width: 120px;" />
                                        </MudStack>

                                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Edit"
                                                       OnClick="@(() => OpenEditDialog(schedule))">
                                                Edit
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" Color="Color.Error"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                       OnClick="@(() => ConfirmDelete(schedule))"
                                                       Disabled="@(schedule.CurrentBookings > 0)">
                                                Delete
                                            </MudButton>
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>

                        @if (_totalCount > _pageSize)
                        {
                            <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                                <MudPagination Count="@((int)Math.Ceiling((double)_totalCount / _pageSize))"
                                               Selected="@_currentPage"
                                               SelectedChanged="OnPageChanged"
                                               Color="Color.Primary" />
                            </MudStack>
                        }
                    }
                </MudStack>
            </div>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">
            You need Provider or Admin access to manage schedules.
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

