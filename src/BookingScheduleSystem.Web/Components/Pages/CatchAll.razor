@page "/{*path}"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation

<PageTitle>Redirecting...</PageTitle>

@code {
    [Parameter]
    public string? Path { get; set; }

    private bool _checked;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _checked)
            return;

        _checked = true;

        // Single-segment slugs are handled by ProviderLanding.razor at /{Slug}.
        // This catch-all only handles multi-segment unknown paths.
        Navigation.NavigateTo("/not-found", replace: true);
    }
}
