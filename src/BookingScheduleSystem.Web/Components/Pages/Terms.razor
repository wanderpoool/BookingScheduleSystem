@page "/terms"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Terms and Conditions | Book Me App!</PageTitle>

<style>
    .terms-page *, .terms-page *::before, .terms-page *::after { margin: 0; padding: 0; box-sizing: border-box; }

    .terms-page {
        font-family: 'DM Sans', system-ui, sans-serif;
        background: #FFF8F0;
        color: #1B2D45;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
    }

    /* ===== CSS VARIABLES ===== */
    .terms-page {
        --clr-bg: #FFF8F0;
        --clr-surface: #FFFFFF;
        --clr-primary: #E85D2A;
        --clr-primary-dark: #C94A1D;
        --clr-primary-light: rgba(232, 93, 42, 0.08);
        --clr-secondary: #1B2D45;
        --clr-accent: #FFC53D;
        --clr-text: #1B2D45;
        --clr-text-muted: #5A6B80;
        --clr-text-light: #8A96A6;
        --clr-border: #E8DFD5;
        --clr-border-light: #F0EBE4;
        --content-max: 720px;
        --sidebar-w: 260px;
    }

    /* ===== ANIMATIONS ===== */
    @@keyframes termsFadeIn {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ===== NAV ===== */
    .terms-nav {
        position: sticky;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        padding: 14px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        background: rgba(255, 248, 240, 0.88);
        border-bottom: 1px solid rgba(232, 223, 213, 0.5);
    }
    .terms-nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #1B2D45;
    }
    .terms-nav-logo-icon {
        width: 36px;
        height: 36px;
        background: #E85D2A;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 17px;
    }
    .terms-nav-logo-text {
        font-weight: 700;
        font-size: 18px;
        letter-spacing: -0.3px;
    }
    .terms-nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
        list-style: none;
    }
    .terms-nav-links a {
        text-decoration: none;
        color: #5A6B80;
        font-size: 14px;
        font-weight: 500;
        transition: color 0.2s;
    }
    .terms-nav-links a:hover { color: #1B2D45; }
    .terms-nav-btn {
        padding: 10px 22px;
        border-radius: 10px;
        background: #E85D2A;
        color: white !important;
        font-weight: 600 !important;
        transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1) !important;
        box-shadow: 0 2px 10px rgba(232, 93, 42, 0.2);
    }
    .terms-nav-btn:hover {
        background: #C94A1D !important;
        transform: translateY(-1px);
    }

    /* ===== HERO ===== */
    .terms-hero {
        padding: 100px 40px 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
        animation: termsFadeIn 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .terms-hero::before {
        content: '';
        position: absolute;
        top: -30%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(232,93,42,0.06) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .terms-hero-breadcrumb {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #5A6B80;
        margin-bottom: 20px;
    }
    .terms-hero-breadcrumb a {
        color: #E85D2A;
        text-decoration: none;
        font-weight: 500;
    }
    .terms-hero-breadcrumb a:hover { text-decoration: underline; }
    .terms-hero-breadcrumb span { color: #E8DFD5; }
    .terms-hero h1 {
        font-size: clamp(36px, 5vw, 52px);
        font-weight: 700;
        letter-spacing: -1.5px;
        line-height: 1.1;
        margin-bottom: 16px;
    }
    .terms-hero-subtitle {
        font-size: 17px;
        color: #5A6B80;
        max-width: 520px;
        margin: 0 auto 24px;
    }
    .terms-hero-meta {
        display: inline-flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .terms-hero-meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #8A96A6;
        font-weight: 500;
    }

    /* ===== LAYOUT ===== */
    .terms-layout {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 40px 100px;
        display: grid;
        grid-template-columns: var(--sidebar-w) 1fr;
        gap: 60px;
        align-items: flex-start;
    }

    /* ===== TABLE OF CONTENTS ===== */
    .terms-toc-wrapper {
        position: sticky;
        top: 90px;
        animation: termsFadeIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
    }
    .terms-toc {
        background: #FFFFFF;
        border: 1px solid #E8DFD5;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(27,45,69,0.03);
    }
    .terms-toc-title {
        font-size: 14px;
        font-weight: 700;
        color: #1B2D45;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .terms-toc-title::before {
        content: '';
        width: 3px;
        height: 16px;
        background: #E85D2A;
        border-radius: 3px;
    }
    .terms-toc-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .terms-toc-list a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        color: #5A6B80;
        transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .terms-toc-list a:hover {
        background: rgba(232, 93, 42, 0.08);
        color: #E85D2A;
    }
    .terms-toc-num {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: #FFF8F0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        color: #8A96A6;
        flex-shrink: 0;
        transition: all 0.2s;
    }
    .terms-toc-list a:hover .terms-toc-num {
        background: #E85D2A;
        color: white;
    }
    .terms-toc-help {
        margin-top: 16px;
        background: #1B2D45;
        border-radius: 14px;
        padding: 20px;
        color: white;
    }
    .terms-toc-help-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 6px;
    }
    .terms-toc-help-desc {
        font-size: 12px;
        color: rgba(255,255,255,0.55);
        line-height: 1.6;
        margin-bottom: 14px;
    }
    .terms-toc-help-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 8px;
        background: rgba(255,255,255,0.12);
        color: white;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        transition: background 0.2s;
    }
    .terms-toc-help-btn:hover { background: rgba(255,255,255,0.2); }

    /* ===== CONTENT ===== */
    .terms-content {
        max-width: var(--content-max);
        animation: termsFadeIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
    }
    .terms-section {
        margin-bottom: 48px;
        scroll-margin-top: 100px;
    }
    .terms-section-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: rgba(232, 93, 42, 0.08);
        color: #E85D2A;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 10px;
    }
    .terms-section h2 {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin-bottom: 16px;
        line-height: 1.2;
    }
    .terms-section p {
        font-size: 15px;
        color: #5A6B80;
        line-height: 1.8;
        margin-bottom: 14px;
    }
    .terms-section p:last-child { margin-bottom: 0; }
    .terms-section strong {
        color: #1B2D45;
        font-weight: 600;
    }

    /* ===== LISTS ===== */
    .terms-list {
        list-style: none;
        margin: 12px 0 16px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .terms-list li {
        display: flex;
        gap: 12px;
        font-size: 15px;
        color: #5A6B80;
        line-height: 1.7;
    }
    .terms-list-icon {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: rgba(232, 93, 42, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 3px;
        color: #E85D2A;
        font-weight: 700;
    }

    /* ===== CALLOUTS ===== */
    .terms-callout {
        background: #FFFFFF;
        border: 1px solid #E8DFD5;
        border-radius: 14px;
        padding: 20px 24px;
        margin: 20px 0;
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }
    .terms-callout-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }
    .terms-callout-icon.info { background: rgba(99, 102, 241, 0.1); }
    .terms-callout-icon.warning { background: rgba(245, 158, 11, 0.12); }
    .terms-callout-icon.ph { background: rgba(232, 93, 42, 0.1); }
    .terms-callout-content { flex: 1; }
    .terms-callout-title {
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 4px;
    }
    .terms-callout-text {
        font-size: 13px;
        color: #5A6B80;
        line-height: 1.7;
    }

    /* ===== DIVIDER ===== */
    .terms-section-divider {
        height: 1px;
        background: #F0EBE4;
        margin: 48px 0;
    }

    /* ===== FOOTER ===== */
    .terms-footer {
        padding: 40px;
        text-align: center;
        border-top: 1px solid #E8DFD5;
    }
    .terms-footer-inner {
        max-width: 600px;
        margin: 0 auto;
    }
    .terms-footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #1B2D45;
        margin-bottom: 12px;
    }
    .terms-footer-logo-icon {
        width: 32px;
        height: 32px;
        background: #E85D2A;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 15px;
    }
    .terms-footer-logo-text {
        font-weight: 700;
        font-size: 16px;
    }
    .terms-footer-desc {
        font-size: 13px;
        color: #5A6B80;
        margin-bottom: 16px;
    }
    .terms-footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }
    .terms-footer-links a {
        font-size: 13px;
        color: #8A96A6;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }
    .terms-footer-links a:hover { color: #E85D2A; }
    .terms-footer-copy {
        margin-top: 20px;
        font-size: 12px;
        color: #8A96A6;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 900px) {
        .terms-layout {
            grid-template-columns: 1fr;
            gap: 0;
            padding: 0 24px 80px;
        }
        .terms-toc-wrapper {
            position: relative;
            top: 0;
            margin-bottom: 40px;
        }
        .terms-hero { padding: 80px 24px 40px; }
        .terms-nav { padding: 12px 20px; }
        .terms-nav-links { display: none; }
    }
</style>

<div class="terms-page">
    <!-- NAV -->
    <nav class="terms-nav">
        <a href="/" class="terms-nav-logo">
            <div class="terms-nav-logo-icon">B</div>
            <span class="terms-nav-logo-text">Book Me App!</span>
        </a>
        <ul class="terms-nav-links">
            <li><a href="/register" class="terms-nav-btn">Get Started Free</a></li>
        </ul>
    </nav>

    <!-- HERO -->
    <section class="terms-hero">
        <div class="terms-hero-breadcrumb">
            <a href="/">Home</a>
            <span>&#8250;</span>
            <a href="#">Legal</a>
            <span>&#8250;</span>
            Terms &amp; Conditions
        </div>
        <h1>Terms and Conditions</h1>
        <p class="terms-hero-subtitle">Please read these terms carefully before using Book Me App! These terms govern your use of our platform for scheduling and managing appointments for service businesses in the Philippines.</p>
        <div class="terms-hero-meta">
            <div class="terms-hero-meta-item">
                <span>&#128197;</span>
                Effective: February 1, 2026
            </div>
            <div class="terms-hero-meta-item">
                <span>&#128260;</span>
                Last Updated: February 10, 2026
            </div>
            <div class="terms-hero-meta-item">
                <span>&#127477;&#127469;</span>
                Philippine Jurisdiction
            </div>
        </div>
    </section>

    <!-- LAYOUT -->
    <div class="terms-layout">

        <!-- TOC SIDEBAR -->
        <aside class="terms-toc-wrapper">
            <div class="terms-toc">
                <div class="terms-toc-title">Table of Contents</div>
                <ul class="terms-toc-list">
                    <li><a href="#acceptance"><span class="terms-toc-num">1</span> Acceptance of Terms</a></li>
                    <li><a href="#definitions"><span class="terms-toc-num">2</span> Definitions</a></li>
                    <li><a href="#eligibility"><span class="terms-toc-num">3</span> Eligibility</a></li>
                    <li><a href="#account"><span class="terms-toc-num">4</span> Account Registration</a></li>
                    <li><a href="#services"><span class="terms-toc-num">5</span> Platform Services</a></li>
                    <li><a href="#booking"><span class="terms-toc-num">6</span> Booking &amp; Scheduling</a></li>
                    <li><a href="#payments"><span class="terms-toc-num">7</span> Payments &amp; Fees</a></li>
                    <li><a href="#cancellation"><span class="terms-toc-num">8</span> Cancellation Policy</a></li>
                    <li><a href="#privacy"><span class="terms-toc-num">9</span> Data Privacy</a></li>
                    <li><a href="#conduct"><span class="terms-toc-num">10</span> User Conduct</a></li>
                    <li><a href="#liability"><span class="terms-toc-num">11</span> Limitation of Liability</a></li>
                    <li><a href="#ip"><span class="terms-toc-num">12</span> Intellectual Property</a></li>
                    <li><a href="#termination"><span class="terms-toc-num">13</span> Termination</a></li>
                    <li><a href="#governing"><span class="terms-toc-num">14</span> Governing Law</a></li>
                    <li><a href="#changes"><span class="terms-toc-num">15</span> Changes to Terms</a></li>
                    <li><a href="#contact"><span class="terms-toc-num">16</span> Contact Us</a></li>
                </ul>
            </div>

            <div class="terms-toc-help">
                <div class="terms-toc-help-title">Need help?</div>
                <div class="terms-toc-help-desc">If you have questions about these terms, our support team is ready to help — in English or Filipino.</div>
                <a href="mailto:support@bookmeapp.ph" class="terms-toc-help-btn">support&#64;bookmeapp.ph</a>
            </div>
        </aside>

        <!-- CONTENT -->
        <main class="terms-content">

            <!-- 1. Acceptance -->
            <div class="terms-section" id="acceptance">
                <div class="terms-section-number">1</div>
                <h2>Acceptance of Terms</h2>
                <p>By accessing or using Book Me App! ("the Platform"), you agree to be bound by these Terms and Conditions ("Terms"). If you do not agree to these Terms, please do not use the Platform.</p>
                <p>These Terms constitute a legally binding agreement between you and <strong>Book Me App! Philippines, Inc.</strong> ("we," "us," or "our"), a company registered under the laws of the Republic of the Philippines with principal office in Makati City, Metro Manila.</p>
                <p>By creating an account, booking an appointment, or listing your services on the Platform — whether as a <strong>Service Provider</strong> (dental clinics, spas, nail salons, barbershops, and similar establishments) or a <strong>Client</strong> (individuals booking appointments) — you acknowledge that you have read, understood, and agree to be bound by these Terms.</p>
            </div>

            <div class="terms-section-divider"></div>

            <!-- 2. Definitions -->
            <div class="terms-section" id="definitions">
                <div class="terms-section-number">2</div>
                <h2>Definitions</h2>
                <p>For the purposes of these Terms, the following definitions apply:</p>
                <ul class="terms-list">
                    <li>
                        <span class="terms-list-icon">a</span>
                        <span><strong>"Platform"</strong> refers to the Book Me App! website, mobile application, and all related services operated by Book Me App! Philippines, Inc.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">b</span>
                        <span><strong>"Service Provider"</strong> refers to dental clinics, spa and massage centers, nail spas, barbershops, beauty salons, and other service-based establishments registered on the Platform within the Philippines.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">c</span>
                        <span><strong>"Client"</strong> refers to any individual who uses the Platform to book, schedule, or manage appointments with a Service Provider.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">d</span>
                        <span><strong>"Appointment"</strong> refers to a confirmed or pending booking for a specific service, date, time, and location made through the Platform.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">e</span>
                        <span><strong>"Service Fee"</strong> refers to any fees charged by Book Me App! for the use of the Platform, including but not limited to subscription fees, transaction fees, and premium feature fees.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">f</span>
                        <span><strong>"Payment Channels"</strong> refers to supported payment methods including GCash, Maya (formerly PayMaya), bank transfers (BPI, BDO, UnionBank, etc.), credit/debit cards, and cash.</span>
                    </li>
                </ul>
            </div>

            <div class="terms-section-divider"></div>

            <!-- 3. Eligibility -->
            <div class="terms-section" id="eligibility">
                <div class="terms-section-number">3</div>
                <h2>Eligibility</h2>
                <p>To use the Platform, you must meet the following requirements:</p>
                <ul class="terms-list">
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span>You must be at least <strong>18 years of age</strong>, or at least 13 years of age with verifiable parental or guardian consent, in accordance with Republic Act No. 10173 (Data Privacy Act of 2012).</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span>If you are a Service Provider, your establishment must be a <strong>legally registered business</strong> in the Philippines, with valid DTI (Department of Trade and Industry) or SEC (Securities and Exchange Commission) registration, and applicable LGU business permits and licenses.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span>Dental clinics must hold a valid <strong>PRC (Professional Regulation Commission) license</strong> for all practicing dentists, and comply with DOH (Department of Health) regulations for dental facilities.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span>Spa, massage, nail spa, and barbershop establishments must comply with local government health and sanitation requirements and hold necessary <strong>sanitary permits</strong>.</span>
                    </li>
                </ul>
                <div class="terms-callout">
                    <div class="terms-callout-icon ph">&#127477;&#127469;</div>
                    <div class="terms-callout-content">
                        <div class="terms-callout-title">Philippine Regulatory Note</div>
                        <div class="terms-callout-text">Service Providers are solely responsible for maintaining all required licenses, permits, and professional certifications as mandated by Philippine law. Book Me App! does not verify or guarantee the licensing status of any Service Provider and shall not be held liable for any regulatory non-compliance.</div>
                    </div>
                </div>
            </div>

            <div class="terms-section-divider"></div>

            <!-- 4. Account Registration -->
            <div class="terms-section" id="account">
                <div class="terms-section-number">4</div>
                <h2>Account Registration</h2>
                <p>To access the full features of the Platform, you must create an account by providing accurate, current, and complete information. You are responsible for maintaining the confidentiality of your account credentials.</p>
                <ul class="terms-list">
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Service Provider accounts</strong> require business name, registered address, type of service (dental, spa, nail, barbershop), valid contact number (Philippine mobile format: +63), email address, and authorized representative information.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Client accounts</strong> require full name, valid Philippine mobile number, and email address. Registration via GCash, Maya, Google, or Facebook sign-in is also supported.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span>You must not create multiple accounts, impersonate another person or business, or use misleading information. Violation may result in immediate suspension or termination.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span>You are fully responsible for all activities conducted through your account. Report any unauthorized access immediately to <strong>support&#64;bookmeapp.ph</strong>.</span>
                    </li>
                </ul>
            </div>

            <div class="terms-section-divider"></div>

            <!-- 5. Platform Services -->
            <div class="terms-section" id="services">
                <div class="terms-section-number">5</div>
                <h2>Platform Services</h2>
                <p>Book Me App! provides a technology platform that enables Service Providers and Clients to connect for appointment scheduling. Our services include, but are not limited to:</p>
                <ul class="terms-list">
                    <li>
                        <span class="terms-list-icon">&#128197;</span>
                        <span><strong>Appointment Scheduling</strong> — Online booking for dental consultations, teeth cleaning, tooth extraction, braces adjustment, spa massage (Swedish, Hilot, Shiatsu, Ventosa), nail spa services (manicure, pedicure, gel nails, nail art), and barbershop services (haircut, shave, beard trim, hair coloring).</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#128276;</span>
                        <span><strong>Automated Reminders</strong> — SMS notifications via Globe, Smart, TNT, and DITO networks; Viber messages; Facebook Messenger alerts; and email reminders.</span>
                    </li>
