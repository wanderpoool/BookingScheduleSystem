@page "/privacy"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Privacy Policy | Book Me App!</PageTitle>

<style>
    .terms-page *, .terms-page *::before, .terms-page *::after { margin: 0; padding: 0; box-sizing: border-box; }

    .terms-page {
        font-family: 'DM Sans', system-ui, sans-serif;
        background: #FFF8F0;
        color: #1B2D45;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
    }

    /* ===== CSS VARIABLES ===== */
    .terms-page {
        --clr-bg: #FFF8F0;
        --clr-surface: #FFFFFF;
        --clr-primary: #E85D2A;
        --clr-primary-dark: #C94A1D;
        --clr-primary-light: rgba(232, 93, 42, 0.08);
        --clr-secondary: #1B2D45;
        --clr-accent: #FFC53D;
        --clr-text: #1B2D45;
        --clr-text-muted: #5A6B80;
        --clr-text-light: #8A96A6;
        --clr-border: #E8DFD5;
        --clr-border-light: #F0EBE4;
        --content-max: 720px;
        --sidebar-w: 260px;
    }

    /* ===== ANIMATIONS ===== */
    @@keyframes termsFadeIn {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ===== NAV ===== */
    .terms-nav {
        position: sticky;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        padding: 14px 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        background: rgba(255, 248, 240, 0.88);
        border-bottom: 1px solid rgba(232, 223, 213, 0.5);
    }
    .terms-nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #1B2D45;
    }
    .terms-nav-logo-icon {
        width: 36px;
        height: 36px;
        background: #E85D2A;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 17px;
    }
    .terms-nav-logo-text {
        font-weight: 700;
        font-size: 18px;
        letter-spacing: -0.3px;
    }
    .terms-nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
        list-style: none;
    }
    .terms-nav-links a {
        text-decoration: none;
        color: #5A6B80;
        font-size: 14px;
        font-weight: 500;
        transition: color 0.2s;
    }
    .terms-nav-links a:hover { color: #1B2D45; }
    .terms-nav-btn {
        padding: 10px 22px;
        border-radius: 10px;
        background: #E85D2A;
        color: white !important;
        font-weight: 600 !important;
        transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1) !important;
        box-shadow: 0 2px 10px rgba(232, 93, 42, 0.2);
    }
    .terms-nav-btn:hover {
        background: #C94A1D !important;
        transform: translateY(-1px);
    }

    /* ===== HERO ===== */
    .terms-hero {
        padding: 100px 40px 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
        animation: termsFadeIn 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .terms-hero::before {
        content: '';
        position: absolute;
        top: -30%;
        right: -10%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(232,93,42,0.06) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .terms-hero-breadcrumb {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #5A6B80;
        margin-bottom: 20px;
    }
    .terms-hero-breadcrumb a {
        color: #E85D2A;
        text-decoration: none;
        font-weight: 500;
    }
    .terms-hero-breadcrumb a:hover { text-decoration: underline; }
    .terms-hero-breadcrumb span { color: #E8DFD5; }
    .terms-hero h1 {
        font-size: clamp(36px, 5vw, 52px);
        font-weight: 700;
        letter-spacing: -1.5px;
        line-height: 1.1;
        margin-bottom: 16px;
    }
    .terms-hero-subtitle {
        font-size: 17px;
        color: #5A6B80;
        max-width: 520px;
        margin: 0 auto 24px;
    }
    .terms-hero-meta {
        display: inline-flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        justify-content: center;
    }
    .terms-hero-meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #8A96A6;
        font-weight: 500;
    }

    /* ===== LAYOUT ===== */
    .terms-layout {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 40px 100px;
        display: grid;
        grid-template-columns: var(--sidebar-w) 1fr;
        gap: 60px;
        align-items: flex-start;
    }

    /* ===== TABLE OF CONTENTS ===== */
    .terms-toc-wrapper {
        position: sticky;
        top: 90px;
        animation: termsFadeIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
    }
    .terms-toc {
        background: #FFFFFF;
        border: 1px solid #E8DFD5;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 20px rgba(27,45,69,0.03);
    }
    .terms-toc-title {
        font-size: 14px;
        font-weight: 700;
        color: #1B2D45;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .terms-toc-title::before {
        content: '';
        width: 3px;
        height: 16px;
        background: #E85D2A;
        border-radius: 3px;
    }
    .terms-toc-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .terms-toc-list a {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        color: #5A6B80;
        transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .terms-toc-list a:hover {
        background: rgba(232, 93, 42, 0.08);
        color: #E85D2A;
    }
    .terms-toc-num {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: #FFF8F0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        color: #8A96A6;
        flex-shrink: 0;
        transition: all 0.2s;
    }
    .terms-toc-list a:hover .terms-toc-num {
        background: #E85D2A;
        color: white;
    }
    .terms-toc-help {
        margin-top: 16px;
        background: #1B2D45;
        border-radius: 14px;
        padding: 20px;
        color: white;
    }
    .terms-toc-help-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 6px;
    }
    .terms-toc-help-desc {
        font-size: 12px;
        color: rgba(255,255,255,0.55);
        line-height: 1.6;
        margin-bottom: 14px;
    }
    .terms-toc-help-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 8px;
        background: rgba(255,255,255,0.12);
        color: white;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        transition: background 0.2s;
    }
    .terms-toc-help-btn:hover { background: rgba(255,255,255,0.2); }

    /* ===== CONTENT ===== */
    .terms-content {
        max-width: var(--content-max);
        animation: termsFadeIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
    }
    .terms-section {
        margin-bottom: 48px;
        scroll-margin-top: 100px;
    }
    .terms-section-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: rgba(232, 93, 42, 0.08);
        color: #E85D2A;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 10px;
    }
    .terms-section h2 {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin-bottom: 16px;
        line-height: 1.2;
    }
    .terms-section p {
        font-size: 15px;
        color: #5A6B80;
        line-height: 1.8;
        margin-bottom: 14px;
    }
    .terms-section p:last-child { margin-bottom: 0; }
    .terms-section strong {
        color: #1B2D45;
        font-weight: 600;
    }

    /* ===== LISTS ===== */
    .terms-list {
        list-style: none;
        margin: 12px 0 16px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .terms-list li {
        display: flex;
        gap: 12px;
        font-size: 15px;
        color: #5A6B80;
        line-height: 1.7;
    }
    .terms-list-icon {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: rgba(232, 93, 42, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 3px;
        color: #E85D2A;
        font-weight: 700;
    }

    /* ===== CALLOUTS ===== */
    .terms-callout {
        background: #FFFFFF;
        border: 1px solid #E8DFD5;
        border-radius: 14px;
        padding: 20px 24px;
        margin: 20px 0;
        display: flex;
        gap: 14px;
        align-items: flex-start;
    }
    .terms-callout-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }
    .terms-callout-icon.info { background: rgba(99, 102, 241, 0.1); }
    .terms-callout-icon.warning { background: rgba(245, 158, 11, 0.12); }
    .terms-callout-icon.ph { background: rgba(232, 93, 42, 0.1); }
    .terms-callout-content { flex: 1; }
    .terms-callout-title {
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 4px;
    }
    .terms-callout-text {
        font-size: 13px;
        color: #5A6B80;
        line-height: 1.7;
    }

    /* ===== DIVIDER ===== */
    .terms-section-divider {
        height: 1px;
        background: #F0EBE4;
        margin: 48px 0;
    }

    /* ===== FOOTER ===== */
    .terms-footer {
        padding: 40px;
        text-align: center;
        border-top: 1px solid #E8DFD5;
    }
    .terms-footer-inner {
        max-width: 600px;
        margin: 0 auto;
    }
    .terms-footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: #1B2D45;
        margin-bottom: 12px;
    }
    .terms-footer-logo-icon {
        width: 32px;
        height: 32px;
        background: #E85D2A;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 15px;
    }
    .terms-footer-logo-text {
        font-weight: 700;
        font-size: 16px;
    }
    .terms-footer-desc {
        font-size: 13px;
        color: #5A6B80;
        margin-bottom: 16px;
    }
    .terms-footer-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }
    .terms-footer-links a {
        font-size: 13px;
        color: #8A96A6;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s;
    }
    .terms-footer-links a:hover { color: #E85D2A; }
    .terms-footer-copy {
        margin-top: 20px;
        font-size: 12px;
        color: #8A96A6;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 900px) {
        .terms-layout {
            grid-template-columns: 1fr;
            gap: 0;
            padding: 0 24px 80px;
        }
        .terms-toc-wrapper {
            position: relative;
            top: 0;
            margin-bottom: 40px;
        }
        .terms-hero { padding: 80px 24px 40px; }
        .terms-nav { padding: 12px 20px; }
        .terms-nav-links { display: none; }
    }
</style>

<div class="terms-page">
    <!-- NAV -->
    <nav class="terms-nav">
        <a href="/" class="terms-nav-logo">
            <div class="terms-nav-logo-icon">B</div>
            <span class="terms-nav-logo-text">Book Me App!</span>
        </a>
        <ul class="terms-nav-links">
            <li><a href="/register" class="terms-nav-btn">Get Started Free</a></li>
        </ul>
    </nav>

    <!-- HERO -->
    <section class="terms-hero">
        <div class="terms-hero-breadcrumb">
            <a href="/">Home</a>
            <span>&#8250;</span>
            <a href="#">Legal</a>
            <span>&#8250;</span>
            Privacy Policy
        </div>
        <h1>Privacy Policy</h1>
        <p class="terms-hero-subtitle">This Privacy Policy explains how Book Me App! collects, uses, stores, and protects your personal information in compliance with Philippine data privacy laws.</p>
        <div class="terms-hero-meta">
            <div class="terms-hero-meta-item">
                <span>&#128197;</span>
                Effective: February 1, 2026
            </div>
            <div class="terms-hero-meta-item">
                <span>&#128260;</span>
                Last Updated: February 25, 2026
            </div>
            <div class="terms-hero-meta-item">
                <span>&#127477;&#127469;</span>
                RA 10173 Compliant
            </div>
        </div>
    </section>

    <!-- LAYOUT -->
    <div class="terms-layout">

        <!-- TOC SIDEBAR -->
        <aside class="terms-toc-wrapper">
            <div class="terms-toc">
                <div class="terms-toc-title">Table of Contents</div>
                <ul class="terms-toc-list">
                    <li><a href="#introduction"><span class="terms-toc-num">1</span> Introduction</a></li>
                    <li><a href="#information-collected"><span class="terms-toc-num">2</span> Information We Collect</a></li>
                    <li><a href="#how-we-use"><span class="terms-toc-num">3</span> How We Use Your Data</a></li>
                    <li><a href="#legal-basis"><span class="terms-toc-num">4</span> Legal Basis</a></li>
                    <li><a href="#data-sharing"><span class="terms-toc-num">5</span> Data Sharing</a></li>
                    <li><a href="#data-retention"><span class="terms-toc-num">6</span> Data Retention</a></li>
                    <li><a href="#data-security"><span class="terms-toc-num">7</span> Data Security</a></li>
                    <li><a href="#your-rights"><span class="terms-toc-num">8</span> Your Rights</a></li>
                    <li><a href="#cookies"><span class="terms-toc-num">9</span> Cookies &amp; Tracking</a></li>
                    <li><a href="#children"><span class="terms-toc-num">10</span> Children's Privacy</a></li>
                    <li><a href="#international"><span class="terms-toc-num">11</span> International Transfers</a></li>
                    <li><a href="#breach"><span class="terms-toc-num">12</span> Data Breach Protocol</a></li>
                    <li><a href="#changes"><span class="terms-toc-num">13</span> Policy Changes</a></li>
                    <li><a href="#contact"><span class="terms-toc-num">14</span> Contact &amp; Complaints</a></li>
                </ul>
            </div>

            <div class="terms-toc-help">
                <div class="terms-toc-help-title">Data Privacy Officer</div>
                <div class="terms-toc-help-desc">For any questions about how we handle your personal data, contact our DPO directly.</div>
                <a href="mailto:dpo@bookmeapp.ph" class="terms-toc-help-btn">dpo&#64;bookmeapp.ph</a>
            </div>
        </aside>

        <!-- CONTENT -->
        <main class="terms-content">

            <!-- 1. Introduction -->
            <div class="terms-section" id="introduction">
                <div class="terms-section-number">1</div>
                <h2>Introduction</h2>
                <p><strong>Book Me App! Philippines, Inc.</strong> ("we," "us," or "our") is committed to protecting the privacy and personal information of all users of the Book Me App! platform ("the Platform"). This Privacy Policy describes our practices regarding the collection, use, storage, disclosure, and protection of your personal data.</p>
                <p>This Privacy Policy is issued in compliance with <strong>Republic Act No. 10173</strong>, also known as the Data Privacy Act of 2012 ("DPA"), its Implementing Rules and Regulations ("IRR"), and all applicable issuances of the <strong>National Privacy Commission ("NPC")</strong>.</p>
                <p>By creating an account, making a booking, listing your services, or otherwise using the Platform, you acknowledge that you have read and understood this Privacy Policy and consent to the collection and processing of your personal data as described herein.</p>
                <div class="terms-callout">
                    <div class="terms-callout-icon ph">&#127477;&#127469;</div>
                    <div class="terms-callout-content">
                        <div class="terms-callout-title">Data Privacy Act of 2012 (RA 10173)</div>
                        <div class="terms-callout-text">This Privacy Policy is anchored on the principles of transparency, legitimate purpose, and proportionality as mandated by the Data Privacy Act. Book Me App! Philippines, Inc. is a registered Personal Information Controller (PIC) with the National Privacy Commission.</div>
                    </div>
                </div>
            </div>

            <div class="terms-section-divider"></div>

            <!-- 2. Information We Collect -->
            <div class="terms-section" id="information-collected">
                <div class="terms-section-number">2</div>
                <h2>Information We Collect</h2>
                <p>We collect personal information that is necessary, relevant, and proportionate to the services we provide. The types of information we collect depend on whether you are a <strong>Client</strong> (booking appointments) or a <strong>Service Provider</strong> (offering services).</p>

                <p><strong>From Clients:</strong></p>
                <ul class="terms-list">
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Account information</strong> — Full name, email address, mobile number (Philippine format: +63), and password.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Booking information</strong> — Appointment date, time, selected service, chosen provider, and any notes or special requests you provide.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Transaction information</strong> — Payment method, transaction reference numbers, and billing details (processed by third-party payment partners; we do not store full payment credentials).</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Device and usage information</strong> — Browser type, IP address, device identifier, operating system, pages visited, and access timestamps.</span>
                    </li>
                </ul>

                <p><strong>From Service Providers:</strong></p>
                <ul class="terms-list">
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Business information</strong> — Organization name, subdomain, business type, description, branch location(s), and operating hours.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Owner/staff information</strong> — Names, email addresses, mobile numbers, and roles of authorized personnel managing the account.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Schedule and availability data</strong> — Working hours, service durations, provider schedules, and capacity settings.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#8226;</span>
                        <span><strong>Subscription and billing data</strong> — Plan type, payment history, and invoice records.</span>
                    </li>
                </ul>

                <div class="terms-callout">
                    <div class="terms-callout-icon warning">&#9888;&#65039;</div>
                    <div class="terms-callout-content">
                        <div class="terms-callout-title">Sensitive Personal Information</div>
                        <div class="terms-callout-text">For dental clinic and healthcare-related bookings, limited health information (e.g., dental history, allergies, or medical conditions relevant to treatment) may be collected through booking notes. Under RA 10173, this constitutes sensitive personal information and is subject to stricter processing requirements. We collect such data only with your explicit consent and solely for the purpose of facilitating your appointment.</div>
                    </div>
                </div>
            </div>

            <div class="terms-section-divider"></div>

            <!-- 3. How We Use Your Data -->
            <div class="terms-section" id="how-we-use">
                <div class="terms-section-number">3</div>
                <h2>How We Use Your Data</h2>
                <p>We process your personal data only for specific, declared, and legitimate purposes. These include:</p>
                <ul class="terms-list">
                    <li>
                        <span class="terms-list-icon">&#128197;</span>
                        <span><strong>Appointment management</strong> — Processing, confirming, modifying, and cancelling bookings between Clients and Service Providers.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#128276;</span>
                        <span><strong>Notifications and reminders</strong> — Sending appointment confirmations, reminders, status updates, and cancellation notices via email, SMS, or in-app notifications.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#128179;</span>
                        <span><strong>Payment processing</strong> — Facilitating payments between Clients and Service Providers through authorized third-party payment channels.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#128100;</span>
                        <span><strong>Account administration</strong> — Creating and managing your account, verifying your identity, and providing customer support.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#128202;</span>
                        <span><strong>Platform improvement</strong> — Analyzing usage patterns and feedback to enhance the Platform's features, performance, and user experience.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#128274;</span>
                        <span><strong>Security and fraud prevention</strong> — Detecting, investigating, and preventing fraudulent or unauthorized access, abuse, or violations of our Terms and Conditions.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">&#9878;&#65039;</span>
                        <span><strong>Legal compliance</strong> — Fulfilling obligations under Philippine law, responding to lawful requests from government authorities, and enforcing our legal rights.</span>
                    </li>
                </ul>
                <p>We will not use your personal data for purposes that are incompatible with the purposes stated above, unless we obtain your separate consent or are required to do so by law.</p>
            </div>

            <div class="terms-section-divider"></div>

            <!-- 4. Legal Basis for Processing -->
            <div class="terms-section" id="legal-basis">
                <div class="terms-section-number">4</div>
                <h2>Legal Basis for Processing</h2>
                <p>Under the Data Privacy Act of 2012, we process your personal data based on the following lawful criteria:</p>
                <ul class="terms-list">
                    <li>
                        <span class="terms-list-icon">a</span>
                        <span><strong>Consent</strong> — You provide your informed, voluntary, and specific consent when you create an account and agree to this Privacy Policy. For sensitive personal information (e.g., health-related booking notes), we obtain your explicit consent prior to collection.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">b</span>
                        <span><strong>Contractual necessity</strong> — Processing is necessary to perform our obligations under the Terms and Conditions, including facilitating bookings, managing accounts, and processing payments.</span>
                    </li>
                    <li>
                        <span class="terms-list-icon">c</span>
