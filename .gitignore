agent/*.txt

# Local plans, infra notes, mock-ups
infra/*.md
plans/*.md
mock-ups/

# SES request
ses-production-access-request.txt

# Temp test projects
tmp-test/

# Development settings with secrets (secrets injected via env vars in production)
**/appsettings.Development.json

# Windows nul artifacts
nul
